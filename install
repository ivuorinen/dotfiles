#!/usr/bin/env bash
set -e

CONFIG="install.conf.yaml"
LINKS_CONFIG="dotbot-links.yaml"
DOTBOT_DIR="tools/dotbot"

DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTBOT_BIN_PATH="${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}"
DOTBOT_HOST="$(hostname -s)"

LINKS_ONLY=false
DOTBOT_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --links) LINKS_ONLY=true ;;
    *) DOTBOT_ARGS+=("$arg") ;;
  esac
done

# Run every executable in hosts/<host>/<phase>.d in alphabetical order, when the
# directory exists. `before.d` runs ahead of the main install.conf, `after.d`
# once everything else is done. A failing hook is logged but never aborts the
# install. Hooks must be executable; non-executable files are skipped with a
# warning. DOTFILES is exported so hooks can locate the repo.
run_host_hooks()
{
  local phase hook_dir hook
  phase="$1"
  hook_dir="${BASEDIR}/hosts/${DOTBOT_HOST}/${phase}.d"
  if [ -z "${DOTBOT_HOST}" ] || [ ! -d "${hook_dir}" ]; then
    return 0
  fi
  echo "-> Running ${phase}.d hooks for host ${DOTBOT_HOST}"
  for hook in "${hook_dir}"/*; do
    [ -e "${hook}" ] || continue # empty dir: skip the literal glob
    if [ ! -x "${hook}" ]; then
      echo "(!) Skipping non-executable ${phase}.d hook: ${hook}" >&2
      continue
    fi
    echo "   -> ${hook##*/}"
    "${hook}" || echo "(!) ${phase}.d hook failed (continuing): ${hook}" >&2
  done
}

# Apply hosts/<host>/install.conf.yaml when it exists. Runs in both modes,
# because host overlays are mostly link steps and `--links` must refresh
# them too. Extra arguments are passed to dotbot ahead of DOTBOT_ARGS; the
# links-only path uses dotbot's own `--except shell` so host
# provisioning steps stay out of a symlink refresh.
run_host_config()
{
  local host_config
  if [ -z "${DOTBOT_HOST}" ]; then
    return 0
  fi
  host_config="${BASEDIR}/hosts/${DOTBOT_HOST}/${CONFIG}"
  echo "-> Trying if host config can be found: ${host_config}"
  if [ ! -r "${host_config}" ] || [ ! -f "${host_config}" ]; then
    return 0
  fi
  echo "(!) Found ${host_config}"
  "${DOTBOT_BIN_PATH}" \
    -d "${BASEDIR}" \
    --plugin-dir=tools/dotbot-include \
    -c "${host_config}" \
    "$@" \
    "${DOTBOT_ARGS[@]}"
}

export DOTFILES="${BASEDIR}"

cd "${BASEDIR}"
git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive
git submodule update --init --recursive "${DOTBOT_DIR}"

# config/git/shared no longer sets the `store` helper, so git stops reading
# the plaintext file it wrote and nothing else would surface the tokens still
# in it. Deleting it here would leave those tokens live; revoke them first.
STALE_GIT_CREDENTIALS="${HOME}/.cache/git/git-credentials"
if [ -e "${STALE_GIT_CREDENTIALS}" ]; then
  echo "(!) ${STALE_GIT_CREDENTIALS} holds plaintext tokens from the removed git store helper." >&2
  echo "    Revoke each token it lists at its host, then: rm '${STALE_GIT_CREDENTIALS}'" >&2
fi

if [ "$LINKS_ONLY" = true ]; then
  "${DOTBOT_BIN_PATH}" \
    -d "${BASEDIR}" \
    --plugin-dir=tools/dotbot-include \
    -c "${LINKS_CONFIG}" \
    "${DOTBOT_ARGS[@]}"
  run_host_config --except shell
  exit 0
fi

run_host_hooks before

"${DOTBOT_BIN_PATH}" \
  -d "${BASEDIR}" \
  --plugin-dir=tools/dotbot-include \
  -c "${CONFIG}" \
  "${DOTBOT_ARGS[@]}"

run_host_config

run_host_hooks after
