  https://github.com/junegunn/fzf

    local/bin/fzf-tmux
    config/fzf/completion.bash
    config/fzf/completion.zsh
    config/fzf/key-bindings.bash
    config/fzf/key-bindings.zsh
    config/fzf/key-bindings.fish
    local/man/man1/fzf.1
