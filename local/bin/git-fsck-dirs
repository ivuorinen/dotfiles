#!/usr/bin/env bash
#USAGE about "Run git fsck on all git repos in subdirectories"
#USAGE flag "--help" help="Display help"
#USAGE flag "--version" help="Display version"
#USAGE flag "-v --verbose" help="Verbose output"
#USAGE flag "-q --quiet" help="Quiet output"
# FSCK subfolders git projects.
#
# Actions taken: git fsck --no-dangling --full
#
# Copyright 2023 Ismo Vuorinen. All Rights Reserved.
# License: MIT <https://opensource.org/license/mit/>

set -euo pipefail

# Enable verbosity with VERBOSE=1
VERBOSE="${VERBOSE:-0}"
DEBUG="${DEBUG:-0}"

if [ "$DEBUG" -eq 1 ]; then
  set -x
fi

# Function to print messages if VERBOSE is enabled
# $1 - message (string)
msg()
{
  if [ "$VERBOSE" -eq 1 ]; then
    echo "$1"
  fi
  return 0
}

# Show red error message
# $1 - message (string)
msg_err()
{
  echo "$(tput setaf 1)Error: $1$(tput sgr0)"
}

# Function to perform git fsck on a repository
# $1 - directory (string)
fsck_repo()
{
  local dir dirs collected_errors collected_repos
  dir="$(realpath "$1")"
  collected_errors="$2"
  collected_repos="$3"

  msg "Processing: $dir"

  if [ ! -d "$dir/.git" ]; then
    echo "$dir" >> "$collected_errors"
    msg "  (!) Skipping (no .git)"
    return
  fi

  echo "$dir" >> "$collected_repos"

  # The verdict is git's exit status, not grep's. Piping fsck into
  # `grep -v '^notice:'` and testing that pipeline reports the exit code of
  # grep, which is 1 whenever it prints nothing — exactly what a clean fsck
  # produces. Every healthy repository was therefore recorded as broken.
  # grep now only filters what is shown.
  # `|| fsck_status=$?` rather than a bare assignment: under set -e a failing
  # command substitution aborts the script, which would skip the summary for
  # exactly the repositories this tool exists to report.
  local fsck_output fsck_status=0
  fsck_output="$(git -C "$dir" fsck --no-dangling --full --no-progress 2>&1)" || fsck_status=$?

  printf '%s\n' "$fsck_output" | grep -vE '^notice:' || true

  if [ "$fsck_status" -ne 0 ]; then
    echo "$dir" >> "$collected_errors"
    msg "  (!) Issues found in: $dir"
  fi
}

# Main function
main()
{
  local starting_path errors_file repo_count_file dirs dirs_count REPO_COUNT ERROR_COUNT

  starting_path=${1:-$(pwd)}
  errors_file="${2:-/tmp/git-fsck-errors.txt}"
  repo_count_file="${3:-/tmp/git-fsck-repo-count.txt}"

  # Start both files empty. They were only ever created by appending, so a
  # run that found no repository left repo_count_file absent and the
  # `wc -l <` below aborted under set -e — no summary, bare exit 1. Starting
  # fresh also stops a previous run's results leaking into this one's counts.
  : > "$errors_file"
  : > "$repo_count_file"

  # If starting_point=. or starting_point=.., set it to the current directory
  if [ "$starting_path" = "." ]; then
    starting_path="$(pwd)"
  elif [ "$starting_path" = ".." ]; then
    starting_path="$(dirname "$(pwd)")"
  fi

  # Check if starting_path exists
  if [ ! -d "$starting_path" ]; then
    msg_err "Error: Directory '$starting_path' not found."
    return 1
  fi

  # Collect the directories
  dirs=$(find "$starting_path" -mindepth 1 -maxdepth 1 -type d)
  # Filter out unwanted directories
  dirs=$(echo "$dirs" \
    | grep -vE '^\./\.git$' \
    | grep -vE '^\./\.svn$' \
    | grep -vE '^\./\.hg$' \
    | grep -vE '^\./\.bzr$')
  # Count the directories for reporting and processing
  dirs_count=$(echo "$dirs" | wc -l | tr -d ' ')

  # If dirs_count is 0, exit early
  if [ "$dirs_count" -eq 0 ]; then
    msg_err "No directories found in $starting_path."
    return 0
  fi

  echo "Checking $dirs_count directories in $starting_path..."

  for dir in $dirs; do
    fsck_repo "$dir" "$errors_file" "$repo_count_file"
  done

  # Collect the results and trim the output
  REPO_COUNT=$(wc -l < "$repo_count_file" | tr -d ' ')
  ERROR_COUNT=$(wc -l < "$errors_file" | tr -d ' ')

  rm -f "$errors_file" "$repo_count_file"

  echo ""
  echo "Summary:"
  echo "Checked $REPO_COUNT repositories from $dirs_count directories."
  if [ "$ERROR_COUNT" -gt 0 ]; then
    echo "Found issues in $ERROR_COUNT repositories."
    return 1
  else
    echo "All repositories passed."
    return 0
  fi
}

main "$@"
exit $?
