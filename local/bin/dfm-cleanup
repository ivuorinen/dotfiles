#!/usr/bin/env bash
#USAGE cmd "cleanup" help="Remove old installs, caches, and unused packages" {
#USAGE   cmd "all" help="Run old-vms, mise, and caches cleanup in sequence"
#USAGE   cmd "caches" help="Clear mise and uv caches"
#USAGE   cmd "docker" help="Remove stopped containers and dangling images"
#USAGE   cmd "mise" help="Prune unused tool versions and clear mise download cache"
#USAGE   cmd "old-vms" help="Remove old version manager directories replaced by mise" {
#USAGE     flag "--dry-run" help="Show what would be removed without removing"
#USAGE   }
#USAGE }
#
# @description Remove old installs, caches, and unused packages (dfm cleanup)
# dfm cleanup — remove old installs, caches, and unused packages.
#
# vim: ft=bash ts=2 sw=2 et
# shellcheck source-path=$HOME/.dotfiles/local/bin

_dfm_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=local/bin/dfm-lib
source "$_dfm_dir/dfm-lib" || {
  echo "${0##*/}: cannot load dfm-lib (broken install?)" >&2
  exit 1
}
dfm_bootstrap_for "$@"

dfm_cleanup()
{
  case "${1:-}" in
    all)
      local rc=0
      msgr msg "Running all cleanup tasks..."
      dfm_cleanup old-vms || rc=1
      dfm_cleanup mise || rc=1
      dfm_cleanup caches || rc=1
      if [[ $rc -eq 0 ]]; then
        msgr yay "All cleanup tasks complete"
      else
        msgr warn "Cleanup finished with errors"
      fi
      return "$rc"
      ;;

    # No brew step: mise's brew manager shares /opt/homebrew with the brew
    # CLI, and `brew cleanup`/`brew autoremove` can remove or relink kegs mise
    # poured.
    caches)
      # Each tool's status counts, so `cleanup all` sees a failure and the
      # success line is printed only when everything worked.
      local cache_rc=0
      msgr run "Clearing caches..."
      if command -v mise > /dev/null 2>&1; then
        msgr nested "mise cache..."
        mise cache clean || cache_rc=1
      fi
      if command -v uv > /dev/null 2>&1; then
        msgr nested "uv cache..."
        uv cache clean || cache_rc=1
      fi
      if ((cache_rc == 0)); then
        msgr yay "Cache cleanup complete"
      else
        msgr err "Cache cleanup failed"
      fi
      return "$cache_rc"
      ;;

    docker)
      if ! command -v docker > /dev/null 2>&1; then
        msgr warn "docker not found — skipping"
        return 0
      fi
      msgr run "Running docker system prune..."
      if ! docker system prune -f; then
        msgr err "docker system prune failed"
        return 1
      fi
      msgr yay "Docker cleanup complete"
      ;;

    mise)
      if ! command -v mise > /dev/null 2>&1; then
        msgr warn "mise not found — skipping"
        return 0
      fi
      local mise_rc=0
      msgr run "Pruning unused mise tool versions..."
      mise prune --yes || mise_rc=1
      msgr run "Clearing mise download cache..."
      mise cache clean || mise_rc=1
      if ((mise_rc == 0)); then
        msgr yay "mise cleanup complete"
      else
        msgr err "mise cleanup failed"
      fi
      return "$mise_rc"
      ;;

    old-vms)
      local script="$DOTFILES/scripts/cleanup-old-version-managers.sh"
      if [[ ! -f "$script" ]]; then
        msgr err "cleanup-old-version-managers.sh not found: $script"
        return 1
      fi
      msgr run "Removing old version manager installs..."
      # Arguments pass through: the script takes --dry-run.
      bash "$script" "${@:2}"
      ;;

    *) dfm_fallback "${1:-}" ;;
  esac
}

dfm_cleanup "$@"
