#!/usr/bin/env bash
#USAGE cmd "install" help="Install tools, packages, and configurations" {
#USAGE   cmd "all" help="Install everything in the correct order"
#USAGE   cmd "cheat-databases" help="Install cheat external cheatsheet databases"
#USAGE   cmd "fonts" help="Install programming fonts"
#USAGE   cmd "gh" help="Install GitHub CLI Extensions"
#USAGE   cmd "macos" help="Apply macOS defaults and the login shell"
#USAGE   cmd "mise" help="Install tools via mise (runtimes + CLI tools)"
#USAGE   cmd "xcode-cli-tools" help="Install Xcode CLI tools (macOS)"
#USAGE }
#
# @description Install tools, packages, and configurations (dfm install)
# dfm install — install tools, packages, and configurations.
#
# vim: ft=bash ts=2 sw=2 et
# shellcheck source-path=$HOME/.dotfiles/local/bin

_dfm_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=local/bin/dfm-lib
source "$_dfm_dir/dfm-lib" || {
  echo "${0##*/}: cannot load dfm-lib (broken install?)" >&2
  exit 1
}
dfm_bootstrap_for "$@"

# Collected outcomes for the `install all` closing summary.
_install_failures=()
_install_skips=()

# Run one install step, logging (never aborting) on failure so `install all`
# always reaches the end. A partial install is surfaced in the summary rather
# than dying at the first broken step.
run_step()
{
  local label="$1"
  shift
  local rc=0
  "$@" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    msgr err "Step failed (continuing): $label [exit $rc]"
    _install_failures+=("$label")
  fi
  return 0
}

# Guard a step on a tool it needs. Returns non-zero so the caller skips the
# step, and records the skip — e.g. once mise itself fails, every step that
# relies on a mise-installed tool skips cleanly instead of erroring.
require_bin()
{
  local label="$1" bin="$2"
  command -v "$bin" > /dev/null 2>&1 && return 0
  msgr warn "Skipping $label: required tool '$bin' not found"
  _install_skips+=("$label (needs $bin)")
  return 1
}

# Install the mise binary when it is missing. `install all`, `install mise`
# and `install macos` all apply mise config, so each calls this first rather
# than assuming another step ran. No binary is the one fatal case: the caller
# records the failure and the steps that need mise skip.
# MISE_INSTALL_PATH puts the binary in the directory added to
# PATH: mise.run defaults to ~/.local/bin/mise whatever XDG_BIN_HOME says, so
# a custom XDG_BIN_HOME left mise installed but not found. The installer is
# downloaded to a temporary file and run only after the download completes:
# piped into sh, a failed download ran nothing yet read as success, and a
# transfer cut after the script's install_mise call installed mise while the
# step reported failure. The subshell owns the trap that removes the file.
ensure_mise()
{
  command -v mise &> /dev/null && return 0
  local bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
  msgr nested "Installing mise..."
  (
    installer="$(mktemp)" || exit 1
    # shellcheck disable=SC2064 # expand now: the path is fixed
    trap "rm -f -- $(printf '%q' "$installer")" EXIT
    curl -fsSL -o "$installer" https://mise.run \
      && MISE_INSTALL_PATH="$bin_dir/mise" sh "$installer"
  ) || {
    msgr err "Failed to install mise"
    return 1
  }
  export PATH="$bin_dir:$PATH"
  return 0
}

# Offer to create GITHUB_TOKEN secrets when the token is missing: mise queries
# the GitHub API for every github: tool, and unauthenticated requests are
# limited to 60 an hour. Asks once per run, and only a person at a terminal.
_install_token_asked=0
install_github_token()
{
  [[ -n "${GITHUB_TOKEN:-}" ]] && return 0
  ((_install_token_asked == 0)) || return 0
  _install_token_asked=1
  msgr warn "GITHUB_TOKEN is not set — mise queries GitHub API for each github: tool"
  msgr nested "Unauthenticated requests are rate-limited to 60/hr; installs may fail mid-run"
  if [[ ! -t 0 ]]; then
    msgr nested "Non-interactive shell; skipping token prompt"
    return 0
  fi
  local answer
  read -rp "Create GITHUB_TOKEN secrets now? [y/N] " answer
  if [[ "${answer:-N}" =~ ^[Yy]$ ]]; then
    "$DFM" secrets github
    # shellcheck disable=SC1090
    [[ -f "$DOTFILES/config/secrets.d/github.sh" ]] \
      && source "$DOTFILES/config/secrets.d/github.sh"
  fi
}

# Apply what `mise bootstrap` owns, in its own order: the declared packages
# (apt/dnf; Homebrew formulae and casks on macOS), macOS defaults, the login
# shell, and their hooks. Tools are left to the `install mise` step, which
# tolerates a host-unsupported tool; a user without sudo rights also skips the
# packages part, which needs sudo.
install_bootstrap()
{
  local skip=tools
  if ! "$DOTFILES/local/bin/is-sudoer"; then
    msgr warn "Skipping system packages: $(id -un) has no sudo rights"
    _install_skips+=("system packages (no sudo rights)")
    skip=tools,packages
  fi
  msgr run "Applying mise bootstrap (all but tools)..."
  mise bootstrap --yes --skip "$skip"
}

# Handle install section commands
dfm_install()
{
  case "$1" in
    all)
      msgr msg "Installing everything..."
      _install_failures=()
      _install_skips=()

      # Xcode CLI tools first on macOS: git and the compilers the rest needs.
      [[ $OSTYPE == darwin* ]] && run_step "xcode cli tools" dfm_install xcode-cli-tools

      # mise sets up the machine in its own order (`mise bootstrap --help`):
      # packages, macOS defaults, the login shell (fish, from the packages),
      # then the tools — including the pipx: Python tools, ntfy and shellspec
      # pinned in config/mise/config.toml. Nothing here keeps that order.
      if ensure_mise; then
        install_github_token
        run_step "mise bootstrap" install_bootstrap
        run_step "mise tools" dfm_install mise
      else
        _install_failures+=("mise (not installed)")
      fi

      # Fonts on Linux. macOS gets them as casks in the bootstrap above; on
      # Linux mise would need a Linuxbrew prefix created with sudo for them.
      [[ $OSTYPE == darwin* ]] || run_step "fonts" dfm_install fonts

      run_step "cheat databases" dfm_install cheat-databases
      require_bin "gh extensions" gh && run_step "gh extensions" dfm_install gh

      # Completions, docs and manpages from the usage specs.
      msgr run "Generating completions and docs from usage specs..."
      if bash "$DOTFILES/scripts/install-completions.sh"; then
        msgr run_done "Completions and docs generated!"
      else
        msgr warn "Some completions/docs failed to generate (non-fatal)"
      fi

      # Closing summary: surface skips and failures so a partial install is
      # visible instead of silently incomplete, and exit 1 after a failed
      # step so ./install (and anything else calling this) sees it.
      if [[ ${#_install_skips[@]} -gt 0 ]]; then
        msgr warn "Skipped ${#_install_skips[@]} step(s):"
        for _s in "${_install_skips[@]}"; do msgr nested "$_s"; done
      fi
      if [[ ${#_install_failures[@]} -gt 0 ]]; then
        msgr err "Completed with ${#_install_failures[@]} failed step(s):"
        for _f in "${_install_failures[@]}"; do msgr nested "$_f"; done
        return 1
      fi
      msgr yay "All done!"
      ;;

    cheat-databases)
      # Every script runs; any failure is named and fails the step, instead
      # of the status of whichever script happened to run last.
      msgr run "Installing cheat databases..."
      local database cheat_rc=0
      for database in "$DOTFILES"/scripts/install-cheat-*.sh; do
        [[ -f "$database" ]] || continue
        if bash "$database"; then
          msgr run_done "Cheat: ${database##*/} run"
        else
          msgr err "Cheat: ${database##*/} failed"
          cheat_rc=1
        fi
      done
      return "$cheat_rc"
      ;;

    fonts)
      msgr run "Installing fonts..."
      bash "$DOTFILES/scripts/install-fonts.sh" \
        && msgr yay "Installed fonts!"
      ;;

    gh)
      msgr run "Installing GitHub CLI Extensions..."
      bash "$DOTFILES/scripts/install-gh-extensions.sh" \
        && msgr yay "github cli extensions installed!"
      ;;

    macos)
      # The preferences, the login shell and the post-defaults hook live in
      # config/mise/conf.d/macos-defaults/mise.macos.toml, which mise loads
      # only on macOS. --only runs those two parts of `mise bootstrap`
      # together with their hooks.
      if [[ $OSTYPE != darwin* ]]; then
        msgr warn "Not a macOS system, skipping macOS defaults"
        return 0
      fi
      msgr run "Setting up macOS defaults and the login shell..."
      ensure_mise || return 1
      mise bootstrap --only macos-defaults,user --yes \
        && msgr yay "macOS defaults set!"
      ;;

    mise)
      # The [tools] only. Packages are `dfm packages apply` (and `mise
      # bootstrap` in `install all`).
      msgr run "Installing tools via mise..."
      ensure_mise || return 1
      install_github_token
      # A single host-unsupported tool (e.g. a dotnet tool that will not build
      # on this box) makes `mise install` exit non-zero even though every other
      # tool installed. Do not fail on that — warn and still reshim so the
      # tools that DID install get their shims, and say so at the end instead
      # of claiming success.
      local mise_warnings=0
      if ! mise install --yes; then
        msgr warn "Some mise tools failed to install (host-unsupported?); continuing"
        mise_warnings=1
      fi
      if ! mise reshim; then
        msgr warn "mise reshim failed"
        mise_warnings=1
      fi
      if ((mise_warnings == 0)); then
        msgr yay "mise tools installed!"
      else
        msgr warn "mise tools installed with warnings (see above)"
      fi
      ;;

    xcode-cli-tools)
      msgr run "Installing Xcode CLI tools..."
      bash "$DOTFILES/scripts/install-xcode-cli-tools.sh" \
        && msgr yay "Xcode CLI tools installed!"
      ;;

    *) dfm_fallback "${1:-}" ;;
  esac
}

dfm_install "$@"
