# shellcheck shell=bash
#
# dfm-lib — shared helpers for the dfm command family.
#
# Sourced by the dfm dispatcher and every dfm-* subcommand; it is NOT
# executable on purpose. Keeping the exec bit off means `command -v
# dfm-lib` never matches it (so `dfm lib` cleanly reports "not a dfm
# command") and signals "source me, don't run me".
#
# (c) Ismo Vuorinen <https://github.com/ivuorinen> 2022
# Licensed under MIT, see LICENSE
#
# vim: ft=bash ts=2 sw=2 et
# shellcheck source-path=$HOME/.dotfiles/local/bin

# Directory this library lives in — also the home of the dfm dispatcher
# and every dfm-* subcommand. Resolved from BASH_SOURCE so it is correct
# regardless of which script sourced us or what DOTFILES points at.
_dfm_libdir=$(
  unset CDPATH
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd
)

# Path to the dispatcher. Subcommands re-dispatch ACROSS sections via
# "$DFM <section> <command>" (same-section fan-out uses local function
# calls instead). Routing through the dispatcher keeps the git-style
# lookup in one place.
DFM="$_dfm_libdir/dfm"
export DFM

# The sections call `msgr <verb>` as an external command. On an installed
# machine ~/.local/bin/msgr provides it; on a bare checkout (CI, fresh
# clone) nothing does — resolve it from this directory so dfm works
# before ./install has linked anything.
command -v msgr > /dev/null 2>&1 || PATH="$_dfm_libdir:$PATH"

# Minimal bootstrap for menu/help paths: the shared variables and nothing
# else. It deliberately SKIPS config/shared.sh, which pulls in
# config/exports — `mise activate`, `brew shellenv` and the rest of the
# export chain, together far more than a static menu needs (each of those
# two alone forks a ~20-30 ms subprocess). Action paths use dfm_bootstrap
# (full) instead. Call once near the top of a subcommand via
# dfm_bootstrap_for, after sourcing this file.
dfm_bootstrap_min()
{
  # Helper variables, override with ENVs like `VERBOSE=1 dfm help`
  : "${VERBOSE:=0}"
  : "${DOTFILES:=$HOME/.dotfiles}"
  : "${HOSTFILES:=$DOTFILES/hosts}"
  export DOTFILES HOSTFILES

  # Every dfm-* binary presents itself under the public "dfm" name, so
  # help/usage text reads "dfm install <command>" no matter which binary is
  # actually executing.
  SCRIPT="dfm"
}

# Full bootstrap for action paths: the variable setup plus the (expensive)
# shared shell environment. dfm runs on bash 3.2 (stock macOS) — it is what
# `dfm install all` uses to install a newer bash — so it needs no version
# guard; tests/dfm-lib.bats rejects bash-4-only syntax in the dfm files.
dfm_bootstrap()
{
  dfm_bootstrap_min

  # shared.sh defines VERBOSE-guarded msg()/msg_* helpers and then sources
  # config/exports, whose `msg "Setting up …"` lines stay quiet unless
  # VERBOSE=1. The sections print through the external `msgr` command, so
  # nothing here sources msgr's functions — doing so would replace the
  # guarded msg() with msgr's unconditional one.
  # shellcheck disable=SC1091
  source "$DOTFILES/config/shared.sh"
}

# Bootstrap appropriately for the subcommand's ARGS. A menu/help
# invocation (no args or a help flag) gets the cheap dfm_bootstrap_min;
# anything else gets the full dfm_bootstrap. This keeps `dfm` and
# `dfm <section>` listings fast while real actions still load the
# complete shell environment.
dfm_bootstrap_for()
{
  case "${1:-}" in
    "" | help | -h | --help)
      dfm_bootstrap_min
      ;;
    *)
      dfm_bootstrap
      ;;
  esac
}

# Print a framed menu: TITLE, then one "name:description" entry per further
# argument. The name column is as wide as the longest name, at least 20.
menu_builder()
{
  local title=$1
  local commands=("${@:2}")
  local width=60 rule cmd name desc col=20

  # The rule line, built without a subshell or seq.
  printf -v rule '%*s' "$width" ''
  rule=${rule// /─}

  for cmd in "${commands[@]}"; do
    name=${cmd%%:*}
    ((${#name} > col)) && col=${#name}
  done

  printf "\n%s\n" "$rule"
  printf "%-${width}s\n" "  $title"
  printf "%s\n" "$rule"

  for cmd in "${commands[@]}"; do
    name=${cmd%%:*}
    desc=${cmd#*:}
    printf "  %-${col}s %s\n" "$name" "$desc"
  done
}

# Print the menu of the dfm-* section FILE from its leading usage-spec block
# (the comment lines marked USAGE) — the spec the completions, markdown and
# manpages are generated from, so the menu cannot drift from them. Each
# depth-1 `cmd` is an entry, its nested `arg`/`flag` names appended to the
# entry name. A section without subcommands is titled with its own args and
# shows its help line instead. Only the header is read: the loop stops at the
# first line after the shebang that is not a spec line. Bash 3.2 compatible
# and fork-free.
#
# The marker is written `[#]USAGE` in the patterns below: .mise/tasks/lint-usage
# lints every local/bin file that contains the marker spelled out, and this
# sourced library is not a spec.
dfm_menu()
{
  local file=$1 line section="" section_help="" args=""
  local name="" entry_args="" help="" items=()
  local re_section='^[#]USAGE cmd "([^"]+)"( help="([^"]*)")?'
  local re_cmd='^[#]USAGE   cmd "([^"]+)"( help="([^"]*)")?'
  local re_cmd_arg='^[#]USAGE     (arg|flag) "([^"]+)"'
  local re_section_arg='^[#]USAGE   (arg|flag) "([^"]+)"'

  while IFS= read -r line || [[ -n $line ]]; do
    case $line in
      "#!"*) continue ;;
      [#]USAGE*) ;;
      *) break ;;
    esac
    if [[ $line =~ $re_cmd ]]; then
      [[ -n $name ]] && items+=("$name$entry_args:$help")
      name=${BASH_REMATCH[1]}
      help=${BASH_REMATCH[3]}
      entry_args=""
    elif [[ $line =~ $re_cmd_arg ]]; then
      # Flags are optional by nature; args carry their own <> or [].
      if [[ ${BASH_REMATCH[1]} == flag ]]; then
        entry_args+=" [${BASH_REMATCH[2]}]"
      else
        entry_args+=" ${BASH_REMATCH[2]}"
      fi
    elif [[ $line =~ $re_section_arg ]]; then
      args+=" ${BASH_REMATCH[2]}"
    elif [[ $line =~ $re_section ]]; then
      section=${BASH_REMATCH[1]}
      section_help=${BASH_REMATCH[3]}
    fi
  done < "$file"
  [[ -n $name ]] && items+=("$name$entry_args:$help")

  if ((${#items[@]} == 0)); then
    menu_builder "$SCRIPT $section${args}"
    printf "  %s\n" "$section_help"
  else
    menu_builder "$SCRIPT $section${args:- <command>}" "${items[@]}"
  fi
}

# The `*)` branch of every section with fixed subcommands. No argument or a
# help flag shows the menu. Anything else is an error: the message and the
# menu go to stderr and the script exits 2, so a renamed or removed command
# in a script or an install config fails instead of passing silently.
dfm_fallback()
{
  case "${1:-}" in
    "" | help | -h | --help) dfm_menu "$0" ;;
    *)
      local section=${0##*/}
      msgr err "unknown command: $SCRIPT ${section#dfm-} $1"
      dfm_menu "$0" >&2
      exit 2
      ;;
  esac
}
