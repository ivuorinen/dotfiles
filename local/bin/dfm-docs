#!/usr/bin/env bash
#USAGE cmd "docs" help="Show documentation from docs/" {
#USAGE   arg "[file]" help="Doc file name (docs/<file>.md)"
#USAGE }
#
# @description Show documentation (dfm docs)
# dfm docs — show documentation from docs/*.md.
#
# vim: ft=bash ts=2 sw=2 et
# shellcheck source-path=$HOME/.dotfiles/local/bin

_dfm_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=local/bin/dfm-lib
source "$_dfm_dir/dfm-lib" || {
  echo "${0##*/}: cannot load dfm-lib (broken install?)" >&2
  exit 1
}
# Reading a doc needs no shell environment: glow/bat come from the caller's
# PATH, and cat is the fallback.
dfm_bootstrap_min

# Show a documentation file from docs/. The menu is built by scanning
# docs/*.md (top level only — docs/audit/ is never listed) and using
# each file's first "# " header as its description.
dfm_docs()
{
  USAGE_PREFIX="$SCRIPT docs <file>"
  local docs_dir="$DOTFILES/docs"

  if [[ -z ${1:-} || $1 == help || $1 == -h || $1 == --help ]]; then
    local MENU=() f name desc line
    for f in "$docs_dir"/*.md; do
      [[ -f $f ]] || continue
      name=${f##*/}
      name=${name%.md}
      # Read up to the first "# " header; no subprocess per doc.
      desc=""
      while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line == "# "* ]]; then
          desc=${line#"# "}
          break
        fi
      done < "$f"
      MENU+=("$name:${desc:-$name}")
    done
    menu_builder "$USAGE_PREFIX" "${MENU[@]}"
    return
  fi

  local name=${1##*/}
  local path="$docs_dir/${name%.md}.md"
  if [[ ! -f $path ]]; then
    msgr err "Documentation not found: $path"
    msgr nested "Run '$SCRIPT docs' to list the docs" >&2
    return 2
  fi

  # Plain text when stdout is not a terminal: `dfm docs x | grep`, a hook or
  # a script wants the content, not ANSI. glow additionally emits zero bytes
  # while still exiting 0 in some non-interactive environments, which made
  # piped output silently empty.
  if [[ ! -t 1 ]]; then
    cat "$path"
  # x-glow applies the terminal-palette style so glow follows the theme
  elif command -v glow > /dev/null 2>&1; then
    "$_dfm_dir/x-glow" "$path"
  elif command -v bat > /dev/null 2>&1; then
    bat "$path"
  else
    cat "$path"
  fi
}

dfm_docs "$@"
