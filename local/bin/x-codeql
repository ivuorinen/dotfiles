#!/bin/sh
#USAGE about "CodeQL security scanning wrapper"
#USAGE flag "--path <path>" help="Source path to analyze (default: current directory)"
#USAGE flag "--threat-model <model>" help="CodeQL threat model: default, local, remote or all"
#USAGE flag "--parallel" help="Run language analyses in parallel"
#USAGE flag "-h --help" help="Show help"
#USAGE flag "-v --version" help="Show version"
# x-codeql: CodeQL security scanning wrapper
# POSIX-compatible shell script

set -e

VERSION="1.1.0"

# Display usage information and options
usage()
{
  cat << EOF
Usage: $0 [OPTIONS]

Options:
  --path PATH             Source path to analyze (default: current directory)
  --threat-model MODEL    Taint sources to trust: default, local, remote, all
                          (default: CodeQL's own default; "local" adds argv,
                          environment and stdin as sources)
  --parallel              Run language analyses in parallel
  -h, --help              Show this help message
  -v, --version           Show version

If PATH/.github/codeql/codeql-config.yml exists, its paths-ignore is applied.

Exit codes: 0 success, 1 runtime error.
EOF
  exit "${1:-0}"
}

# Log a timestamped message to stderr
log()
{
  printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >&2
}
# Log an error message and exit
err()
{
  log "ERROR: $*"
  exit 1
}

# Verify codeql binary is available in PATH
check_codeql()
{
  command -v codeql > /dev/null 2>&1 || err "codeql binary not found in PATH"
  log "Found codeql: $(codeql version --format=terse)"
}

# Get or create the CodeQL cache directory
get_cache_dir()
{
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/codeql"
  mkdir -p "$cache" || err "Cannot create cache directory: $cache"
  printf '%s' "$cache"
}

# List the files whose extensions decide which languages to analyse.
# In a git work tree, ask git: that leaves out submodule contents and
# gitignored files, which would otherwise add a language (and a full database
# build) for code the project does not own — one header inside the dotbot
# submodule was enough to trigger a C/C++ build. Elsewhere, walk the tree,
# pruning .git and node_modules.
list_source_files()
{
  if command -v git > /dev/null 2>&1 \
    && git -C "$1" rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    git -C "$1" ls-files --cached --others --exclude-standard
  else
    find "$1" -name .git -prune -o -name node_modules -prune \
      -o -type f -print 2> /dev/null
  fi
}

# Detect supported programming languages in source path
detect_languages()
{
  src_path="$1"
  detected=""

  # Check for GitHub Actions workflows
  if [ -d "$src_path/.github/workflows" ] \
    && find "$src_path/.github/workflows" -name '*.yml' -o -name '*.yaml' \
      2> /dev/null | grep -q .; then
    detected="actions"
  fi

  # Extension -> language mapping and dedupe handled in awk. CodeQL has no
  # "c" language: C and C++ are both extracted as cpp.
  langs=$(list_source_files "$src_path" | awk '
      BEGIN {
        map["c"] = map["h"] = "cpp"
        map["cpp"] = map["cc"] = map["cxx"] = map["hpp"] = map["hxx"] = "cpp"
        map["cs"] = "csharp"
        map["go"] = "go"
        map["java"] = "java"
        map["js"] = map["jsx"] = map["mjs"] = map["ts"] = map["tsx"] = "javascript"
        map["py"] = "python"
        map["rb"] = "ruby"
        map["swift"] = "swift"
      }
      {
        ext = $0
        sub(/^.*\./, "", ext)
        if (ext in map && !seen[map[ext]]++)
          out = out (out == "" ? "" : " ") map[ext]
      }
      END { print out }
    ')

  [ -n "$langs" ] && detected="$detected${detected:+ }$langs"

  [ -z "$detected" ] && err "No supported languages detected in $src_path"

  printf '%s' "$detected"
}

# Install the query pack AND its library pack for a language.
#
# `codeql/<lang>-all` is the library pack carrying the dataflow and taint
# implementation. Without it every taint query still compiles, still reports its
# full rule count, and returns ZERO results — a well-formed SARIF that is
# indistinguishable from clean code. This wrapper then deleted the empty file and
# logged "No results found", turning a broken engine into a clean bill of health.
#
# `--download` on `database analyze` does not repair this: it short-circuits on
# "Already installed" for the query pack and never resolves the missing library
# dependency. So both packs are installed explicitly, before the analysis.
#
# Measured on ivuorinen/skills: 0 results without the library pack, 95 with it,
# under every suite and every threat model.
install_packs()
{
  lang="$1"

  for pack in "codeql/$lang-queries" "codeql/$lang-all"; do
    if ! codeql pack download "$pack" > /dev/null 2>&1; then
      log "WARNING: could not download $pack — results for $lang may be incomplete"
    fi
  done
}

# Fail loudly when the dataflow engine is not actually loaded.
#
# A zero-result run is only trustworthy if a known-positive would have been
# caught. This compiles one throwaway database containing a textbook
# path-injection and asserts the analysis finds it; if it does not, the zero on
# the real tree proves nothing and is reported as a failure rather than as clean.
verify_engine()
{
  cache_dir="$1"
  probe_src="$cache_dir/.probe-src"
  probe_db="$cache_dir/.probe-db"

  # Self-healing: install first, so the common cause of a failed check is
  # repaired rather than merely reported.
  install_packs python

  mkdir -p "$probe_src"
  cat > "$probe_src/probe.py" << 'PROBE'
import sys
import os


def run():
    """Known-positive for py/path-injection: argv straight into a file open."""
    target = sys.argv[1]
    return os.path.getsize(os.path.join("/tmp", target))
PROBE

  if ! codeql database create "$probe_db" --language=python \
    --source-root="$probe_src" --overwrite > /dev/null 2>&1; then
    rm -rf "$probe_src" "$probe_db"
    log "WARNING: engine self-check could not build its probe database; skipping"
    return 0
  fi

  # Always --threat-model=all, never the caller's choice. The probe asks one
  # question — is the dataflow engine loaded — and its taint source is argv,
  # which is a *local* source: under CodeQL's default model that flow is not
  # tracked at all, so a correctly-working engine would report nothing and the
  # check would fail for a reason that has nothing to do with what it tests.
  probe_sarif="$cache_dir/.probe.sarif"
  codeql database analyze "$probe_db" --format=sarif-latest \
    --output="$probe_sarif" --quiet --threat-model=all \
    "codeql/python-queries:codeql-suites/python-security-and-quality.qls" \
    > /dev/null 2>&1 || true

  found=0
  if [ -f "$probe_sarif" ] && command -v jq > /dev/null 2>&1; then
    found=$(jq -r '[.runs[0].results[]? | select(.ruleId | test("path-injection"))] | length' \
      "$probe_sarif" 2> /dev/null || echo 0)
  fi
  rm -rf "$probe_src" "$probe_db" "$probe_sarif"

  if [ "$found" -eq 0 ]; then
    err "engine self-check FAILED: a known path-injection was not detected.
        The dataflow library pack is probably missing, so a zero-result run
        would be meaningless. Try: codeql pack download codeql/python-all"
  fi
  log "Engine self-check passed (known-positive detected)."
}

# Create a CodeQL database for a language
create_database()
{
  lang="$1"
  src_path="$2"
  db_path="$3"

  # Honour the tree's own code-scanning config, so local runs apply the same
  # paths-ignore as GitHub code scanning instead of reporting on vendored and
  # submodule code. Its query list is not used: analyze names its suite.
  set -- --language="$lang" --source-root="$src_path" --overwrite
  config="$src_path/.github/codeql/codeql-config.yml"
  if [ -f "$config" ]; then
    log "Using code-scanning config $config"
    set -- "$@" --codescanning-config="$config"
  fi

  log "Creating $lang database..."
  codeql database create "$db_path" "$@"
}

# Display analysis result statistics from SARIF file
show_results_stats()
{
  sarif_file="$1"
  lang="$2"

  if ! command -v jq > /dev/null 2>&1; then
    # No jq, basic check only
    if [ ! -s "$sarif_file" ] || ! grep -q '"results"' "$sarif_file"; then
      return 1
    fi
    return 0
  fi

  result_count=$(jq -r '.runs[0].results | length' "$sarif_file" 2> /dev/null || echo "0")

  if [ "$result_count" -eq 0 ]; then
    return 1
  fi

  log "Found $result_count result(s) for $lang"
  jq -r '.runs[0].results[] | "\(.ruleId): \(.message.text)"' "$sarif_file" \
    2> /dev/null | head -5 | while read -r line; do
    log "  - $line"
  done
  [ "$result_count" -gt 5 ] && log "  ... and $((result_count - 5)) more"
  return 0
}

# Run CodeQL analysis for a single language
analyze_language()
{
  lang="$1"
  src_path="$2"
  cache_dir="$3"
  output_dir="$4"

  # Extract last 2 path components for unique DB name
  parent="${src_path%/*}"
  path_suffix="${parent##*/}-${src_path##*/}"
  db_path="$cache_dir/db-$path_suffix-$lang"
  sarif_file="$output_dir/codeql-$lang.sarif"

  install_packs "$lang"
  create_database "$lang" "$src_path" "$db_path"

  if [ -n "$THREAT_MODEL_ARG" ]; then
    log "Analyzing $lang with security-and-quality suite (threat model: $THREAT_MODEL)..."
  else
    log "Analyzing $lang with security-and-quality suite..."
  fi

  # Try security-and-quality suite, fall back to default if not found.
  # Keep the first attempt's stderr so a real failure is not misdiagnosed
  # as a missing suite.
  #
  # $THREAT_MODEL_ARG is deliberately unquoted: it is either empty (contributing
  # no argument) or exactly one `--threat-model=<model>` token validated in main.
  analyze_err="$(mktemp)"
  trap 'rm -f -- "$analyze_err"' EXIT
  # shellcheck disable=SC2086
  if ! codeql database analyze "$db_path" \
    --format=sarif-latest \
    --output="$sarif_file" \
    --sarif-category="$lang" \
    --download $THREAT_MODEL_ARG \
    "codeql/$lang-queries:codeql-suites/$lang-security-and-quality.qls" \
    2> "$analyze_err"; then

    log "Suite not found, trying default pack for $lang..."
    # shellcheck disable=SC2086
    if ! codeql database analyze "$db_path" \
      --format=sarif-latest \
      --output="$sarif_file" \
      --sarif-category="$lang" \
      --download $THREAT_MODEL_ARG \
      "codeql/$lang-queries"; then
      cat "$analyze_err" >&2
      rm -f "$analyze_err"
      err "CodeQL analysis failed for $lang"
    fi
  fi
  rm -f "$analyze_err"

  # Check results and clean up if empty
  if [ -f "$sarif_file" ]; then
    if ! show_results_stats "$sarif_file" "$lang"; then
      log "No results found for $lang, removing empty SARIF file"
      rm -f "$sarif_file"
    fi
  fi

  # Cleanup database
  rm -rf "$db_path"
}

# Parse arguments and run CodeQL analysis pipeline
main()
{
  src_path="."
  parallel=0
  THREAT_MODEL=""
  THREAT_MODEL_ARG=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --path)
        src_path="${2:?--path requires an argument}"
        shift 2
        ;;
      --threat-model)
        THREAT_MODEL="${2:?--threat-model requires an argument}"
        case "$THREAT_MODEL" in
          default)
            # CodeQL's own default (remote sources only); pass nothing.
            THREAT_MODEL_ARG=""
            ;;
          local | remote | all)
            THREAT_MODEL_ARG="--threat-model=$THREAT_MODEL"
            ;;
          *)
            err "--threat-model must be one of: default, local, remote, all. Received: '$THREAT_MODEL'"
            ;;
        esac
        shift 2
        ;;
      --parallel)
        parallel=1
        shift
        ;;
      -v | --version)
        printf 'x-codeql %s\n' "$VERSION"
        exit 0
        ;;
      -h | --help)
        usage 0
        ;;
      *)
        err "Unknown option: $1"
        ;;
    esac
  done

  [ -d "$src_path" ] || err "Path does not exist: $src_path"
  src_path="$(cd "$src_path" && pwd)"

  check_codeql
  cache="$(get_cache_dir)"

  log "Detecting languages in $src_path..."
  languages="$(detect_languages "$src_path")"
  log "Found languages: $languages"

  # Only meaningful where the probe's language is actually being analyzed.
  case " $languages " in
    *" python "*) verify_engine "$cache" ;;
  esac

  output_dir="$(pwd)"

  if [ "$parallel" -eq 1 ]; then
    log "Running analyses in parallel..."
    pids=""
    for lang in $languages; do
      analyze_language "$lang" "$src_path" "$cache" "$output_dir" &
      pids="$pids $!"
    done
    fail=0
    for pid in $pids; do
      wait "$pid" || fail=1
    done
    [ "$fail" -eq 0 ] || err "One or more language analyses failed"
  else
    for lang in $languages; do
      analyze_language "$lang" "$src_path" "$cache" "$output_dir"
    done
  fi

  log "Analysis complete. SARIF files in $output_dir"
}

main "$@"
