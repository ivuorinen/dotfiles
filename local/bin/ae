#!/usr/bin/env bash
# age encrypt file with github keys
#USAGE about "Encrypt a file using age with GitHub SSH keys"
#USAGE flag "-f --force" help="Overwrite an existing <file>.age"
#USAGE flag "--delete" help="Delete <file> after a successful encrypt"
#USAGE arg "<file>" help="File or directory to encrypt"

# A shorthand for `a -v encrypt`: one copy of the key fetching and the
# overwrite guards, so a fix cannot land in one wrapper and miss another.
exec "$(dirname -- "$0")/a" -v encrypt "$@"
