#!/usr/bin/env bash
#USAGE cmd "check" help="System information checks" {
#USAGE   cmd "arch" help="Get or check current architecture" {
#USAGE     alias "a"
#USAGE     arg "[arch]" help="Architecture to check against"
#USAGE   }
#USAGE   cmd "host" help="Get or check current hostname" {
#USAGE     alias "h"
#USAGE     alias "hostname"
#USAGE     arg "[hostname]" help="Hostname to check against"
#USAGE   }
#USAGE   cmd "all" help="Run all health checks in sequence"
#USAGE   cmd "brew" help="Verify all Brewfile packages are installed"
#USAGE   cmd "disk" help="Show disk usage for mise installs and brew cache"
#USAGE   cmd "mise" help="Run mise doctor to check mise health"
#USAGE   cmd "perms" help="Verify created directories still have their declared mode"
#USAGE   cmd "tools" help="Verify essential CLI tools are available in PATH"
#USAGE   cmd "updates" help="Show available updates for mise tools and brew packages"
#USAGE }
#
# @description System information and health checks (dfm check)
# dfm check — system information checks (arch, hostname, health).
#
# vim: ft=bash ts=2 sw=2 et
# shellcheck source-path=$HOME/.dotfiles/local/bin

_dfm_dir=$(
  unset CDPATH
  cd -- "$(dirname -- "$0")" && pwd
)
# shellcheck source=local/bin/dfm-lib
if ! source "$_dfm_dir/dfm-lib"; then
  echo "${0##*/}: cannot load dfm-lib (broken install?)" >&2
  exit 1
fi
dfm_bootstrap_for "$@"

# Handle system check commands (arch, hostname)
dfm_check()
{
  USAGE_PREFIX="$SCRIPT check <command>"
  X_HOSTNAME=$(hostname)
  X_ARCH=$(uname)

  MENU=(
    "arch <arch>:Empty <arch> returns current. Exit code 0=match to current, 1=no match."
    "host <host>:Empty <host> returns current. Exit code 0=match to current, 1=no match."
    "all:Run brew, mise, tools, updates, and disk checks in sequence"
    "brew:Verify all Brewfile packages are installed"
    "disk:Show disk usage for mise installs and brew cache"
    "mise:Run mise doctor to check mise health"
    "perms:Verify created directories still have their declared mode"
    "tools:Verify essential CLI tools are available in PATH"
    "updates:Show available updates for mise tools and brew packages"
  )

  case "$1" in
    a | arch)
      [[ $2 == "" ]] && echo "$X_ARCH" && return 0
      [[ $X_ARCH == "$2" ]] && return 0 || return 1
      ;;

    h | host | hostname)
      [[ $2 == "" ]] && echo "$X_HOSTNAME" && return 0
      [[ $X_HOSTNAME == "$2" ]] && return 0 || return 1
      ;;

    all)
      local rc=0
      dfm_check brew || rc=1
      dfm_check mise || rc=1
      dfm_check tools || rc=1
      dfm_check perms || rc=1
      dfm_check updates || rc=1
      dfm_check disk || rc=1
      return "$rc"
      ;;

    perms)
      # dotbot's `create` plugin applies a declared `mode:` only when it
      # creates the path; on every later run it logs "Path exists" and never
      # looks at the mode. So a mode added or tightened after a machine was
      # provisioned is a no-op there, and drift introduced by anything else is
      # never repaired — `./install` still exits 0. This check is the missing
      # half: it reads the declared modes out of dotbot-links.yaml rather than
      # keeping a second hardcoded list that would drift from it.
      local links="$DOTFILES/dotbot-links.yaml"
      local defaults="$DOTFILES/tools/dotbot-defaults.yaml"
      local default_mode rc=0 checked=0

      default_mode=$(awk '
        /^ *create: *$/ { in_create = 1; next }
        in_create && /mode:/ { gsub(/[^0-7]/, "", $2); print $2; exit }
      ' "$defaults")
      # No silent fallback. 0777 mirrors dotbot's own os.makedirs default, but
      # for a *checker* it is the worst possible guess: an unreadable or
      # restructured defaults file would make every unmoded directory "pass"
      # at world-writable, and print `chmod 0777` as the repair.
      if [[ -z "$default_mode" ]]; then
        msgr err "Cannot read the create default mode from $defaults"
        return 1
      fi

      while read -r want path; do
        path="${path/#\~/$HOME}"
        if [[ ! -d "$path" ]]; then
          # Not an error: several entries are only created on the hosts that
          # need them, and `dfm check` runs on all of them.
          continue
        fi
        local have
        # GNU coreutils first, BSD/macOS second. %Lp is the permission bits
        # without the file type, which is what %a gives on GNU.
        have=$(stat -c '%a' "$path" 2> /dev/null || stat -f '%Lp' "$path" 2> /dev/null)
        [[ -n "$have" ]] || continue
        checked=$((checked + 1))
        if ((8#$have != 8#$want)); then
          # Normalise both sides: stat prints 777, the YAML carries 0700, and
          # concatenating a literal 0 onto whichever one lacks it produces
          # 00700 in the chmod line the user is meant to paste.
          local have_o want_o
          printf -v have_o '%04o' "$((8#$have))"
          printf -v want_o '%04o' "$((8#$want))"
          msgr err "mode drift: $path is $have_o, declared $want_o"
          msgr nested "fix: chmod $want_o $path"
          rc=1
        fi
      done < <(awk -v def="$default_mode" '
        /^- create:/ { in_create = 1; next }
        /^- / { in_create = 0 }
        !in_create { next }
        /^ *#/ { next }
        /^    [^ ]/ {
          if (path != "") print mode, path
          line = $0
          sub(/^    /, "", line)
          sub(/:[[:space:]]*$/, "", line)
          path = line
          mode = def
          next
        }
        /^      mode:/ { m = $2; gsub(/[^0-7]/, "", m); mode = m }
        END { if (path != "") print mode, path }
      ' "$links")

      if ((rc == 0)); then
        msgr yay "All $checked created directories match their declared mode"
      else
        msgr err "Run the chmod lines above; ./install cannot repair an existing path"
      fi
      return "$rc"
      ;;

    brew)
      if ! command -v brew > /dev/null 2>&1; then
        msgr warn "brew not found — skipping"
        return 0
      fi
      local brewfile="$DOTFILES/config/homebrew/Brewfile"
      msgr run "Checking Brewfile..."
      if ! brew bundle check --file="$brewfile" --no-upgrade; then
        msgr err "Some Brewfile packages missing — run 'dfm brew install' to sync"
        return 1
      fi
      msgr yay "All Brewfile packages installed"
      ;;

    disk)
      local mise_installs="${XDG_DATA_HOME:-$HOME/.local/share}/mise/installs"
      msgr msg "Disk usage for tool stores:"
      if [[ -d "$mise_installs" ]]; then
        msgr nested "mise installs: $(du -sh "$mise_installs" 2> /dev/null | cut -f1)"
      fi
      if command -v brew > /dev/null 2>&1; then
        msgr nested "brew cache:    $(du -sh "$(brew --cache)" 2> /dev/null | cut -f1)"
      fi
      if command -v uv > /dev/null 2>&1; then
        local uv_cache
        uv_cache=$(uv cache dir 2> /dev/null)
        [[ -n "$uv_cache" ]] \
          && msgr nested "uv cache:      $(du -sh "$uv_cache" 2> /dev/null | cut -f1)"
      fi
      ;;

    mise)
      if ! command -v mise > /dev/null 2>&1; then
        msgr warn "mise not found"
        return 1
      fi
      mise doctor
      ;;

    tools)
      local missing=()
      local tool
      for tool in git mise fish starship fzf tmux nvim rg fd eza delta zoxide; do
        command -v "$tool" > /dev/null 2>&1 || missing+=("$tool")
      done
      if [[ ${#missing[@]} -gt 0 ]]; then
        msgr err "Missing tools: ${missing[*]}"
        return 1
      fi
      msgr yay "All essential tools found in PATH"
      ;;

    updates)
      if command -v mise > /dev/null 2>&1; then
        msgr msg "mise outdated:"
        mise outdated || true
      fi
      if command -v brew > /dev/null 2>&1; then
        msgr msg "brew outdated:"
        brew outdated || true
      fi
      ;;

    *) menu_builder "$USAGE_PREFIX" "${MENU[@]}" ;;
  esac
}

dfm_check "$@"
