#!/usr/bin/env sh
#USAGE about "Send Pushover notifications from the command line"
#USAGE flag "-c <callback>" help="Callback URL"
#USAGE flag "-d <device>" help="Target device"
#USAGE flag "-D <timestamp>" help="Delivery timestamp"
#USAGE flag "-e <expire>" help="Expiration time in seconds"
#USAGE flag "-H <html>" help="Enable HTML formatting (1 or 0)"
#USAGE flag "-m <message>" help="Message body"
#USAGE flag "-p <priority>" help="Priority (-2 to 2)"
#USAGE flag "-r <retry>" help="Retry interval in seconds"
#USAGE flag "-s <sound>" help="Notification sound"
#USAGE flag "-t <title>" help="Message title"
#USAGE flag "-T <token>" help="API token (overrides PUSHOVER_TOKEN env var)"
#USAGE flag "-u <user>" help="User/group key (overrides PUSHOVER_USER env var)"
#USAGE flag "-U <url>" help="Supplementary URL"
#USAGE flag "-l <url_title>" help="URL title"
#
# Send Pushover messages from cli
# Based on https://github.com/mrusme/dotfiles/blob/master/usr/local/bin/pushover
#
# Modified by Ismo Vuorinen <https://github.com/ivuorinen> 2023

# Display usage information for pushover
__pushover_usage()
{
  printf "pushover <options> <message>\n"
  printf " -c <callback>\n"
  printf " -d <device>\n"
  printf " -D <timestamp>\n"
  printf " -e <expire>\n"
  printf " -p <priority>\n"
  printf " -r <retry>\n"
  printf " -t <title>\n"
  printf " -T <TOKEN> (required if not in 'PUSHOVER_TOKEN' env)\n"
  printf " -s <sound>\n"
  printf " -u <url>\n"
  printf " -U <USER> (required if not in 'PUSHOVER_USER' env)\n"
  printf " -a <url_title>\n"
  return 1
}

# Send a pushover notification via curl.
#
# Every value reaches curl as its own argv entry, built up with `set --`.
# Nothing is ever re-parsed by the shell. The previous implementation
# assembled the whole command line into a string and ran it through `eval`,
# so a `$(...)` or a bare `"` anywhere in a value executed as shell code —
# and message bodies are routinely program output (`pushover "failed: $(tail
# -1 log)"`, or .claude/hooks/notify-idle.sh forwarding hook text). POSIX sh
# has no arrays; the positional parameters are the array.
__pushover_send_message()
{
  device="${1:-}"

  set -- -s -S \
    -F "token=${TOKEN}" \
    -F "user=${PUSHOVER_USER_KEY}" \
    -F "message=${message}"

  [ -n "$device" ] && set -- "$@" -F "device=$device"
  [ -n "$callback" ] && set -- "$@" -F "callback=$callback"
  [ -n "$timestamp" ] && set -- "$@" -F "timestamp=$timestamp"
  [ -n "$priority" ] && set -- "$@" -F "priority=$priority"
  [ -n "$retry" ] && set -- "$@" -F "retry=$retry"
  [ -n "$expire" ] && set -- "$@" -F "expire=$expire"
  [ -n "$title" ] && set -- "$@" -F "title=$title"
  [ -n "$sound" ] && set -- "$@" -F "sound=$sound"
  [ -n "$url" ] && set -- "$@" -F "url=$url"
  [ -n "$url_title" ] && set -- "$@" -F "url_title=$url_title"

  response="$("${CURL}" "$@" "${PUSHOVER_URL}")"
  printf "%s\n" "$response"

  # Parse response status. Expect JSON like: {"status":1,"request":"..."}
  if echo "$response" | grep -q '"status"[[:space:]]*:[[:space:]]*1'; then
    r=0
  else
    r=1
  fi

  if [ "$r" -ne 0 ]; then
    # Extract possible error message from JSON
    err=$(echo "$response" | grep -o '"errors".*' | sed 's/"errors"[:,\[]//g' | tr -d '[]"')
    [ -n "$err" ] && printf "%s: %s\n" "$0" "$err" >&2
    printf "%s: Failed to send message\n" "$0" >&2
  fi

  return "$r"
}

CURL="$(command -v curl)"
PUSHOVER_URL="https://api.pushover.net/1/messages.json"
TOKEN="${PUSHOVER_TOKEN:-}"
# Not named USER: that is a standard environment variable other code in the
# same process reads, and the previous version overwrote it for the whole run.
PUSHOVER_USER_KEY="${PUSHOVER_USER:-}"
devices=""
optstring="c:d:D:e:p:r:t:T:s:u:U:a:h"

callback=""
timestamp=""
priority=""
retry=""
expire=""
title=""
sound=""
url=""
url_title=""

OPTIND=1
while getopts ${optstring} c; do
  case ${c} in
    c)
      callback="${OPTARG}"
      ;;
    d)
      devices="${devices} ${OPTARG}"
      ;;
    D)
      timestamp="${OPTARG}"
      ;;
    e)
      expire="${OPTARG}"
      ;;
    p)
      priority="${OPTARG}"
      ;;
    r)
      retry="${OPTARG}"
      ;;
    t)
      title="${OPTARG}"
      ;;
    T)
      TOKEN="${OPTARG}"
      ;;
    s)
      sound="${OPTARG}"
      ;;
    u)
      url="${OPTARG}"
      ;;
    U)
      PUSHOVER_USER_KEY="${OPTARG}"
      ;;
    a)
      url_title="${OPTARG}"
      ;;

    [h\?])
      __pushover_usage
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

if [ "$#" -lt 1 ]; then
  __pushover_usage
  exit 1
fi
message="$*"

if [ ! -x "${CURL}" ]; then
  printf "CURL is unset, empty, or does not point to curl executable.\n \
    This script requires curl!\n" >&2
  exit 1
fi

# Fail here rather than sending a request that cannot succeed: the API answers
# a missing token with a generic 4xx whose body says nothing about which of the
# two credentials is absent.
if [ -z "${TOKEN}" ]; then
  printf "%s: no API token (set PUSHOVER_TOKEN or pass -T)\n" "$0" >&2
  exit 1
fi
if [ -z "${PUSHOVER_USER_KEY}" ]; then
  printf "%s: no user/group key (set PUSHOVER_USER or pass -U)\n" "$0" >&2
  exit 1
fi

devices="$(printf "%s" "${devices}" | xargs -n1 | sort -u)"

if [ -z "${devices}" ]; then
  __pushover_send_message
  r=${?}
else
  for device in ${devices}; do
    __pushover_send_message "${device}"
    r=${?}
    if [ "${r}" -ne 0 ]; then
      break
    fi
  done
fi
exit "${r}"
