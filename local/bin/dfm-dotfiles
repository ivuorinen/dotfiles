#!/usr/bin/env bash
#USAGE cmd "dotfiles" help="Format the repository and reset configurations" {
#USAGE   cmd "fmt" help="Run every autofixer (mise run fix), then shfmt"
#USAGE   cmd "shfmt" help="Format shell scripts with the repository's shfmt hook"
#USAGE   cmd "reset-nvim" help="Delete nvim's data, state, cache and config, relink it, reinstall tools"
#USAGE }
#
# @description Format and reset dotfiles configurations (dfm dotfiles)
# dfm dotfiles — format the repository and reset configurations.
#
# vim: ft=bash ts=2 sw=2 et
# shellcheck source-path=$HOME/.dotfiles/local/bin

_dfm_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=local/bin/dfm-lib
source "$_dfm_dir/dfm-lib" || {
  echo "${0##*/}: cannot load dfm-lib (broken install?)" >&2
  exit 1
}
dfm_bootstrap_for "$@"

# Run the repository's own shfmt hook over every tracked file, so this formats
# exactly what the commit gate checks, with the shfmt pin and flags in
# .pre-commit-config.yaml rather than a second copy of them here. prek exits
# non-zero when a hook changes files, so a failing first run is retried: a
# clean second run means the first one only reformatted.
dotfiles_shfmt()
{
  msgr run "Running the shfmt hook on every tracked file"
  if (cd "$DOTFILES" && mise exec -- prek run shfmt --all-files); then
    msgr yay "Shell scripts were already formatted"
  elif (cd "$DOTFILES" && mise exec -- prek run shfmt --all-files); then
    msgr yay "Shell scripts formatted"
  else
    msgr err "The shfmt hook failed; see its output above"
    return 1
  fi
}

# Handle dotfiles formatting and reset commands
dfm_dotfiles()
{
  case "${1:-}" in
    fmt | shfmt)
      if ! command -v mise > /dev/null 2>&1; then
        msgr err "mise not found; run '$SCRIPT install mise' first"
        return 1
      fi
      if [[ $1 == fmt ]]; then
        msgr run "Running every autofixer (mise run fix)"
        if ! (cd "$DOTFILES" && mise run fix); then
          msgr err "mise run fix failed"
          return 1
        fi
      fi
      dotfiles_shfmt
      ;;

    reset-nvim)
      local data="${XDG_DATA_HOME:-$HOME/.local/share}/nvim"
      local state="${XDG_STATE_HOME:-$HOME/.local/state}/nvim"
      local cache="${XDG_CACHE_HOME:-$HOME/.cache}/nvim"
      local config="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
      # Plugins, undo history and sessions cannot be recovered, so a person at
      # a terminal confirms first. Without a terminal it runs as before.
      if [[ -t 0 ]]; then
        local answer
        msgr warn "This deletes $data, $state, $cache and $config"
        read -rp "Continue? [y/N] " answer
        case "$answer" in
          [yY] | [yY][eE][sS]) ;;
          *)
            msgr msg "Aborted — nothing removed"
            return 0
            ;;
        esac
      fi
      msgr run "Cleaning nvim data, state, cache and config"
      if ! rm -rf "$data" "$state" "$cache" "$config"; then
        msgr err "Failed to delete nvim's data, state, cache or config"
        return 1
      fi
      msgr ok "Deleted nvim's data, state, cache and config"
      if ! mkdir -p "${config%/*}" || ! ln -s "$DOTFILES/config/nvim" "$config"; then
        msgr err "Failed to link $config to $DOTFILES/config/nvim"
        return 1
      fi
      msgr ok "Linked $config -> $DOTFILES/config/nvim"
      if ! "$DFM" install mise; then
        msgr err "Failed to install mise tools"
        return 1
      fi
      msgr run_done "nvim reset!"
      ;;

    *) dfm_fallback "${1:-}" ;;
  esac
}

dfm_dotfiles "$@"
