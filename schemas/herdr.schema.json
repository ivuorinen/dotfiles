{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "herdr configuration",
  "description": "Repo-local schema: no upstream schema exists. Types follow the keys this repo sets; other keys are allowed.",
  "type": "object",
  "properties": {
    "onboarding": {
      "type": "boolean"
    },
    "ui": {
      "type": "object",
      "properties": {
        "toast": {
          "type": "object",
          "properties": {
            "delivery": {
              "type": "string"
            }
          }
        },
        "show_agent_labels_on_pane_borders": {
          "type": "boolean"
        },
        "agent_panel_sort": {
          "type": "string"
        },
        "status_indicators": {
          "type": "string"
        },
        "sound": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "auto_switch": {
          "type": "boolean"
        }
      }
    },
    "keys": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
