{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pi open-tui extension settings",
  "description": "Repo-local schema: no upstream schema exists. Types follow the keys this repo sets; other keys are allowed.",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "inlineFooter": {
      "type": "boolean"
    },
    "settingsLanguage": {
      "type": "string"
    },
    "cursorStyle": {
      "type": "string"
    },
    "icons": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        }
      }
    },
    "footerSegments": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "boolean"
        },
        "hostname": {
          "type": "boolean"
        },
        "sessionName": {
          "type": "boolean"
        },
        "gitBranch": {
          "type": "boolean"
        },
        "gitStatus": {
          "type": "boolean"
        },
        "gitCommit": {
          "type": "boolean"
        },
        "runtime": {
          "type": "boolean"
        },
        "context": {
          "type": "boolean"
        },
        "tokens": {
          "type": "boolean"
        },
        "cost": {
          "type": "boolean"
        },
        "extensionStatuses": {
          "type": "boolean"
        },
        "capitalizeProviderName": {
          "type": "boolean"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tps": {
          "type": "boolean"
        },
        "ttft": {
          "type": "boolean"
        },
        "duration": {
          "type": "boolean"
        },
        "tokens": {
          "type": "boolean"
        },
        "stalls": {
          "type": "boolean"
        },
        "cost": {
          "type": "boolean"
        }
      }
    },
    "thinkingPeek": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "integer"
        }
      }
    }
  }
}
