{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Neovim vim.pack lockfile",
  "description": "Repo-local schema: no upstream schema exists. Types follow the keys this repo sets; other keys are allowed.",
  "type": "object",
  "properties": {
    "plugins": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["rev"],
        "properties": {
          "rev": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    }
  }
}
