{
  "components": {
    "editor": {
      "enabled": true,
      "style": "minimalist",
      "codexQuota": true,
      "colorSource": "terminal",
      "borderColorMode": "adaptive",
      "modelLabel": "id",
      "viewportIndicators": true,
      "styles": {
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)(  $fast_mode)(  $codex_quota)",
          "completionMenu": "palette"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)(  $fast_mode)(  $codex_quota)",
          "completionMenu": "palette"
        },
        "accent-rail": {
          "rail": "▎",
          "asciiRail": "|",
          "transparent": false
        },
        "minimalist": {
          "formats": {
            "bottomLeft": "$session_name$join_sep($git_branch)"
          },
          "pathDisplay": "compact",
          "contextFormat": "percent-total",
          "contextGauge": true,
          "showSessionName": true,
          "showTimer": false,
          "showCost": true,
          "showCacheHit": false,
          "showGit": true,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "separator": "dot"
        }
      }
    },
    "footer": {
      "style": "starship",
      "codexQuota": false,
      "colorSource": "terminal",
      "modelLabel": "id",
      "styles": {
        "starship": {
          "format": "$cwd( on $git_branch)( $git_status)( $git_metrics)",
          "responsive": true,
          "compactFormat": "$cwd$wrap(on $git_branch) $git_status$wrap($git_metrics)",
          "compactMaxLines": 1,
          "separator": "dot",
          "contextStyle": "text",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "basename",
            "depth": 0
          },
          "segments": {
            "cwd": false,
            "sessionName": false,
            "gitBranch": false,
            "gitStatus": true,
            "gitCounts": true,
            "gitCommit": false,
            "gitMetrics": true,
            "runtime": false,
            "modelInfo": false,
            "context": false,
            "tokens": false,
            "cost": false,
            "sessionDuration": false,
            "username": false,
            "time": false,
            "os": false,
            "packageVersion": false
          },
          "gitBranch": {
            "maxLength": 20
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": false,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": true
          },
          "extensionStatuses": {
            "defaultPlacement": "right",
            "placements": {
              "pi-lens-lsp": "right"
            },
            "colorModes": {
              "pi-lens-lsp": "zentui"
            }
          }
        }
      }
    },
    "userMessages": {
      "enabled": true,
      "style": "compact"
    },
    "selectorBorders": {
      "enabled": true,
      "style": "zentui",
      "colorSource": "terminal"
    },
    "thinkingSteps": {
      "enabled": true,
      "mode": "tree"
    },
    "workingLine": {
      "enabled": true,
      "turnSummary": true,
      "turnSummaryFormat": "Turn took $turn_duration$join_sep(thought for $thought_duration)$join_sep(↑$input_tokens ↓$output_tokens)$join_sep$token_rate",
      "spinner": "braille",
      "spinnerIntervalMs": 100,
      "animateSpinnerColor": true,
      "textIntervalMs": 60,
      "textAnimation": "classic",
      "placement": "above",
      "colorSource": "terminal",
      "messages": {
        "custom": true,
        "values": [
          "Sautéing…",
          "Cooking…",
          "Ionizing…",
          "Zigzagging…",
          "Razzle-dazzling…",
          "Photosynthesizing…",
          "Nucleating…",
          "Brewing…",
          "Combobulating…",
          "Boogieing…",
          "Befuddling…",
          "Alchemizing…",
          "Conjuring…",
          "Baking…",
          "Simmering…",
          "Blanching…"
        ]
      },
      "segments": {
        "tokenRate": true,
        "tool": true,
        "elapsed": true,
        "thought": true,
        "tokens": true
      }
    },
    "toolDisplay": {
      "enabled": true,
      "style": "balanced",
      "registerToolOverrides": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "grep": true,
        "find": true,
        "ls": true
      },
      "builtinRendererOverrides": {},
      "customToolOverrides": {},
      "readOutputMode": "summary",
      "searchOutputMode": "count",
      "mcpOutputMode": "summary",
      "bashOutputMode": "summary",
      "previewLines": 8,
      "expandedPreviewMaxLines": 4000,
      "bashCollapsedLines": 10,
      "diffViewMode": "auto",
      "diffIndicatorMode": "bars",
      "diffSplitMinWidth": 120,
      "diffCollapsedLines": 24,
      "diffWordWrap": true,
      "showTruncationHints": false
    },
    "extensionStatuses": {
      "visibility": {
        "pi-lens-lsp": "hide"
      },
      "defaultVisibility": "show"
    }
  },
  "icons": {
    "mode": "nerd"
  }
}
