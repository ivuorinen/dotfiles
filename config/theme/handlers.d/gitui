#!/usr/bin/env bash
# handlers.d/gitui — swap ~/.config/gitui/theme.ron symlink to the active
# family's palette for the mode, or remove a stale link when the family
# ships none. Refuses to clobber a regular file (N-021 guard). gitui reads
# theme.ron on each launch, so no live-process refresh is required.
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$0")/../_lib.sh"

mode="${1:-}"
[[ "$mode" = "dark" || "$mode" = "light" ]] || exit 2
_theme_family > /dev/null || exit 1

src="$(_palette "$mode" gitui.ron)" || src=""
dst="$HOME/.config/gitui/theme.ron"

mkdir -p -- "$(dirname -- "$dst")"
_link_palette "$src" "$dst"
