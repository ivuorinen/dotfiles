#!/usr/bin/env bash
# handlers.d/yazi — swap ~/.config/yazi/theme.toml symlink to the active
# family's palette for the mode, or remove a stale link when the family
# ships none. The palette references a syntect theme at
# ~/.config/yazi/<bat theme name, spaces as dashes>.tmTheme; this handler
# symlinks those into place from the bat themes vendored under
# config/bat/themes/ (single source of truth, no duplication), naming them
# from the family's bat.theme files. Refuses to clobber regular files
# (N-021 guard).
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$0")/../_lib.sh"

mode="${1:-}"
[[ "$mode" = "dark" || "$mode" = "light" ]] || exit 2
_theme_family > /dev/null || exit 1

dotfiles="${DOTFILES:-$HOME/.dotfiles}"
src="$(_palette "$mode" yazi.toml)" || src=""
dst="$HOME/.config/yazi/theme.toml"

mkdir -p -- "$(dirname -- "$dst")"
rc=0
_link_palette "$src" "$dst" || rc=1

# Provide both modes' tmThemes up front so a flip never leaves
# `syntect_theme` pointing at a missing file (yazi falls back to a
# built-in scheme on read failure, but the warning noise is undesirable).
for m in dark light; do
  name_file="$(_palette "$m" bat.theme)" || continue
  name=""
  read -r name < "$name_file" || true
  [[ -n "$name" ]] || continue
  tm_src="$dotfiles/config/bat/themes/${name}.tmTheme"
  # if, not &&: a missing tmTheme is a skip, and a false test as the
  # loop's last command would otherwise become the handler's exit status.
  if [[ -r "$tm_src" ]]; then
    _idempotent_ln_sf "$tm_src" "$HOME/.config/yazi/${name// /-}.tmTheme" || rc=1
  fi
done
exit "$rc"
