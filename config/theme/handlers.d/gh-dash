#!/usr/bin/env bash
# handlers.d/gh-dash — gh-dash layers its config: it always loads
# ~/.config/gh-dash/config.yml (writing a default one when it is missing)
# and merges the file named by GH_DASH_CONFIG on top. config/gh-dash/
# config.yml is that base layer, reached through the plain dotbot symlink;
# this handler writes only the overlay — the active family's theme palette
# — into the theme state dir (GH_DASH_CONFIG is set in config/exports and
# config/fish/exports.fish). A family without a gh-dash palette gets an
# empty mapping, so gh-dash falls back to its default colours.
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$0")/../_lib.sh"

mode="${1:-}"
[[ "$mode" = "dark" || "$mode" = "light" ]] || exit 2
_theme_family > /dev/null || exit 1

dst="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-theme/gh-dash-config.yml"

if theme="$(_palette "$mode" gh-dash.theme.yml)"; then
  content="$(cat -- "$theme")"
else
  echo "gh-dash handler: active family ships no gh-dash palette; writing an empty overlay" >&2
  content='{}'
fi
_atomic_write "$dst" "$content"
