#!/usr/bin/env bash
# handlers.d/gh-dash — gh-dash reads a single config.yml that mixes user
# sections (PR/issue queries) with the inline `theme:` block, so we can't
# symlink-swap. Concat base.yml + the active family's theme palette into
# the theme state dir and let shells point gh-dash at it via
# GH_DASH_CONFIG (config/exports, config/fish/exports.fish). Writing
# outside ~/.config keeps config/gh-dash a plain dotbot symlink with no
# install.conf exclude. GH_DASH_CONFIG is exported unconditionally, so a
# family without a gh-dash palette gets base.yml alone (gh-dash's default
# colours) rather than no file at all.
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$0")/../_lib.sh"

mode="${1:-}"
[[ "$mode" = "dark" || "$mode" = "light" ]] || exit 2
_theme_family > /dev/null || exit 1

dotfiles="${DOTFILES:-$HOME/.dotfiles}"
base="$dotfiles/config/gh-dash/base.yml"
dst="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-theme/gh-dash-config.yml"

[[ -r "$base" ]] || {
  echo "gh-dash handler: missing $base" >&2
  exit 1
}

if theme="$(_palette "$mode" gh-dash.theme.yml)"; then
  content="$(
    cat -- "$base"
    printf '\n'
    cat -- "$theme"
  )"
else
  echo "gh-dash handler: active family ships no gh-dash palette; writing base config only" >&2
  content="$(cat -- "$base")"
fi
_atomic_write "$dst" "$content"
