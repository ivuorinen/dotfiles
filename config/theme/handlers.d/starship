#!/usr/bin/env bash
# handlers.d/starship — compose the prompt (config/starship/starship.toml) with
# the active family's palette for the mode into
# $XDG_STATE_HOME/dotfiles-theme/starship.toml and link it at
# ~/.config/starship.toml. A family without a palette gets the stale link
# and composed file removed (starship then uses its defaults) so palettes
# never mix. Refuses to clobber a regular file (N-021 guard).
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$0")/../_lib.sh"

mode="${1:-}"
[[ "$mode" = "dark" || "$mode" = "light" ]] || exit 2
_theme_family > /dev/null || exit 1

base="${DOTFILES:-$HOME/.dotfiles}/config/starship/starship.toml"
out="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-theme/starship.toml"
dst="$HOME/.config/starship.toml"
mkdir -p -- "$(dirname -- "$dst")"

if ! palette="$(_palette "$mode" starship.toml)"; then
  rm -f -- "$out"
  _link_palette "" "$dst"
  exit
fi
[[ -r "$base" ]] || {
  echo "starship handler: missing $base" >&2
  exit 1
}
_atomic_write "$out" "$(cat -- "$base" "$palette")" || {
  echo "starship handler: cannot write $out" >&2
  exit 1
}
_link_palette "$out" "$dst"
