#!/usr/bin/env bash
# handlers.d/starship — swap ~/.config/starship.toml symlink to the active
# family's palette for the mode. A family without one gets the stale link
# removed (starship then uses its defaults) so palettes never mix.
# Refuses to clobber a regular file (N-021 guard).
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$0")/../_lib.sh"

mode="${1:-}"
[[ "$mode" = "dark" || "$mode" = "light" ]] || exit 2
_theme_family > /dev/null || exit 1

src="$(_palette "$mode" starship.toml)" || src=""
dst="$HOME/.config/starship.toml"

mkdir -p -- "$(dirname -- "$dst")"
_link_palette "$src" "$dst"
