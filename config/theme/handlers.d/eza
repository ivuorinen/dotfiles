#!/usr/bin/env bash
# handlers.d/eza — swap ~/.config/eza/theme.yml symlink to the active
# family's palette for the mode, or remove a stale link when the family
# ships none. Refuses to clobber a regular file (N-021 guard). eza reads
# theme.yml on each invocation, so no shell refresh is required.
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$0")/../_lib.sh"

mode="${1:-}"
[[ "$mode" = "dark" || "$mode" = "light" ]] || exit 2
_theme_family > /dev/null || exit 1

src="$(_palette "$mode" eza.yml)" || src=""
dst="${EZA_CONFIG_DIR:-$HOME/.config/eza}/theme.yml"

mkdir -p -- "$(dirname -- "$dst")"
_link_palette "$src" "$dst"
