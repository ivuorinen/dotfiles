#!/usr/bin/env bash
# handlers.d/fzf — link the active family's fzf colours for the mode at
# $XDG_STATE_HOME/dotfiles-theme/fzf-colors, the FZF_DEFAULT_OPTS_FILE that
# config/exports and config/fish/config.fish export. fzf reads the file on
# every start, so a flip needs no shell reload. A family without colours
# gets an empty file instead of no file: fzf exits 2 when
# FZF_DEFAULT_OPTS_FILE names a missing one.
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$0")/../_lib.sh"

mode="${1:-}"
[[ "$mode" = "dark" || "$mode" = "light" ]] || exit 2
_theme_family > /dev/null || exit 1

dst="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-theme/fzf-colors"
mkdir -p -- "$(dirname -- "$dst")"

if src="$(_palette "$mode" fzf)"; then
  # The link helper never replaces a regular file, and the empty file a
  # family without colours left here is ours.
  [[ -L "$dst" ]] || rm -f -- "$dst"
  _idempotent_ln_sf "$src" "$dst"
  exit
fi
echo "fzf handler: active family ships no fzf colours; fzf uses its defaults" >&2
_atomic_write "$dst" "" || {
  echo "fzf handler: cannot write $dst" >&2
  exit 1
}
