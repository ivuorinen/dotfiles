#!/usr/bin/env bash
# handlers.d/dircolors — regenerate the LS_COLORS cache from the active
# family's palette for the mode. Cache is sourced by shells via
# `eval "$(< $cache/ls-colors)"`. A family without a dircolors palette
# gets the cache removed (shells then keep the system default) so a
# previous family's colours never linger.
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$0")/../_lib.sh"

mode="${1:-}"
[[ "$mode" = "dark" || "$mode" = "light" ]] || exit 2
_theme_family > /dev/null || exit 1

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-theme"
mkdir -p -- "$state_dir"

src="$(_palette "$mode" dircolors)" || {
  rm -f -- "$state_dir/ls-colors"
  echo "dircolors handler: active family ships no dircolors palette; removed cache" >&2
  exit 0
}

# On macOS, GNU dircolors ships as gdircolors (coreutils via Homebrew).
_dircolors_cmd=""
for _cmd in dircolors gdircolors; do
  if command -v "$_cmd" > /dev/null 2>&1; then
    _dircolors_cmd="$_cmd"
    break
  fi
done

# Bare macOS (no coreutils) has neither: skip with exit 0, as handlers.d/bat
# does for a missing bat. A failure would make apply retry this handler on
# every shell for a tool that is never going to appear.
if [[ -z "$_dircolors_cmd" ]]; then
  echo "dircolors handler: neither dircolors nor gdircolors found in PATH; skipping" >&2
  exit 0
fi

# Capture rc separately because $? clobbers after the test for empty content.
content="$("$_dircolors_cmd" -b "$src")"
rc=$?
if ((rc != 0)) || [[ -z "$content" ]]; then
  echo "dircolors handler: $_dircolors_cmd -b '$src' produced no output (rc=$rc)" >&2
  exit 1
fi
_atomic_write "$state_dir/ls-colors" "$content"
