#!/usr/bin/env bash
# handlers.d/bat — publish the active family's bat theme NAME (from
# palettes.d/<family>/<mode>/bat.theme) to the theme state dir; shells
# export it as BAT_THEME (config/exports and config/fish/exports.fish).
# bat reads BAT_THEME at exec time, so theming never writes into
# ~/.config/bat — config/bat is a plain dotbot symlink with no install.conf
# exclude. A family without a bat.theme gets the state file removed, so
# shells stop exporting a previous family's theme. Also (re)builds the
# syntect cache once so the vendored *.tmTheme files under
# ~/.config/bat/themes/ resolve by name.
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$0")/../_lib.sh"

mode="${1:-}"
[[ "$mode" = "dark" || "$mode" = "light" ]] || exit 2
_theme_family > /dev/null || exit 1

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-theme"
theme=""
if name_file="$(_palette "$mode" bat.theme)"; then
  read -r theme < "$name_file" || true
fi
if [[ -z "$theme" ]]; then
  rm -f -- "$state_dir/bat-theme"
  echo "bat handler: active family ships no bat theme; removed $state_dir/bat-theme" >&2
  exit 0
fi
_atomic_write "$state_dir/bat-theme" "$theme" || {
  echo "bat handler: cannot write $state_dir/bat-theme" >&2
  exit 1
}

# Custom themes are only picked up after `bat cache --build`. Build lazily
# when the cache is missing, or when a *.tmTheme is newer than it, so
# we don't re-syntect on every flip. Without the mtime check, editing a
# theme (for example the AA-darkened Latte) never reaches bat on a host
# whose cache already exists. A bat-less host skips this block; a failed
# build is reported and exits 1, so apply logs it and retries next time.
if command -v bat > /dev/null 2>&1; then
  cache_dir="$(bat --cache-dir 2> /dev/null || true)"
  config_dir="$(bat --config-dir 2> /dev/null || true)"
  if [[ -n "$cache_dir" ]]; then
    stale=0
    if [[ ! -f "$cache_dir/themes.bin" ]]; then
      stale=1
    elif [[ -n "$config_dir" && -d "$config_dir/themes" ]]; then
      for tm in "$config_dir/themes"/*.tmTheme; do
        if [[ "$tm" -nt "$cache_dir/themes.bin" ]]; then
          stale=1
          break
        fi
      done
    fi
    if ((stale)); then
      bat cache --build > /dev/null || {
        echo "bat handler: bat cache --build failed; custom themes will not resolve" >&2
        exit 1
      }
    fi
  fi
fi
