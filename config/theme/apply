#!/usr/bin/env bash
# apply — the actor. Validates mode, atomic-writes state, forks each
# handlers.d/<name> in parallel under a 5s timeout, logs any non-zero
# exit, and returns 0 unless the input was malformed.
#
# Env overrides (test seams):
#   THEME_HANDLERS_DIR     defaults to $DOTFILES/config/theme/handlers.d
#   XDG_STATE_HOME         defaults to $HOME/.local/state
#   DOTFILES_THEME_FAMILY  defaults to the contents of config/theme/family
set -uo pipefail

# shellcheck disable=SC1091
source "$(dirname -- "$0")/_lib.sh"

if [[ $# -ne 1 ]]; then
  echo "apply: usage: apply <dark|light>" >&2
  exit 2
fi

mode="$1"
case "$mode" in
  dark | light) ;;
  *)
    echo "apply: unknown mode '$mode'; expected dark|light" >&2
    exit 2
    ;;
esac

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-theme"
state_file="$state_dir/mode"
family_file="$state_dir/family"
handlers_dir="${THEME_HANDLERS_DIR:-${DOTFILES:-$HOME/.dotfiles}/config/theme/handlers.d}"

# The theme family (config/theme/family) is part of the applied state: a
# family switch at an unchanged mode must still re-run the handlers. An
# unresolvable family is logged and the handlers still run — each one
# fails closed on its own and leaves its destination untouched.
family="$(_theme_family 2> /dev/null)" || {
  family=""
  _log "WARN actor: theme family unresolvable; handlers will fail closed"
}

if [[ -r "$state_file" && -n "$family" ]]; then
  current="" current_family=""
  read -r current < "$state_file" || true
  [[ -r "$family_file" ]] && {
    read -r current_family < "$family_file" || true
  }
  if [[ "$current" = "$mode" && "$current_family" = "$family" ]]; then
    exit 0
  fi
fi

# Both are written before any handler forks: handlers.d/tmux re-sources
# tmux.conf, whose bootstrap reads the mode back through theme-mode.
_atomic_write "$state_file" "$mode"
[[ -n "$family" ]] && _atomic_write "$family_file" "$family"
_log "INFO actor flipped to $mode${family:+ ($family)}"

# Resolve timeout(1) once. Bare-macOS hosts without coreutils have
# neither `timeout` nor `gtimeout`; we fall back to running handlers
# unbounded and log a single WARN so a wedged handler is diagnosable.
TIMEOUT_CMD="$(_resolve_timeout_cmd || true)"
if [[ -z "$TIMEOUT_CMD" ]]; then
  _log "WARN actor: timeout(1) unavailable; running handlers unbounded"
fi

# Fork each handler under the resolved timeout. Capture stderr per handler
# so the actor can label the lines on the way to the log.
declare -a pids names
for h in "$handlers_dir"/*; do
  [[ -x "$h" ]] || continue
  name="$(basename -- "$h")"
  errlog="$state_dir/.handler-$name.err"
  : > "$errlog"
  if [[ -n "$TIMEOUT_CMD" ]]; then
    ("$TIMEOUT_CMD" 5s "$h" "$mode" 2> "$errlog") &
  else
    ("$h" "$mode" 2> "$errlog") &
  fi
  pids+=("$!")
  names+=("$name")
done

# Script runs under `set -uo pipefail` (no `-e`), so a non-zero `wait`
# does not abort the loop — `rc=$?` captures it cleanly. No errexit
# toggle required.
i=0
for pid in "${pids[@]}"; do
  wait "$pid"
  rc=$?
  name="${names[$i]}"
  errlog="$state_dir/.handler-$name.err"
  if ((rc != 0)); then
    _log "WARN handler '$name' exit=$rc"
    if [[ -s "$errlog" ]]; then
      while IFS= read -r line; do
        _log "WARN handler '$name': $line"
      done < "$errlog"
    fi
  elif [[ -s "$errlog" ]]; then
    # A handler that succeeds can still report something worth keeping —
    # e.g. "active family ships no palette; removed stale link". Dropping
    # it would leave an app silently on defaults with no trace here.
    while IFS= read -r line; do
      _log "INFO handler '$name': $line"
    done < "$errlog"
  fi
  rm -f "$errlog"
  i=$((i + 1))
done

exit 0
