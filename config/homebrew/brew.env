# vim: filetype=sh
# dotenv-linter:off LowercaseKey, KeyWithoutValue, ExtraBlankLine, EndingBlankLine
#
# Homebrew configuration, read by brew itself from
# $XDG_CONFIG_HOME/homebrew/brew.env. Plain KEY=value lines only: brew keeps
# only lines that start with HOMEBREW_, so an `export ` prefix drops the line.

HOMEBREW_AUTOREMOVE=true
HOMEBREW_AUTO_UPDATE_SECS=86400
HOMEBREW_CLEANUP_MAX_AGE_DAYS=30
HOMEBREW_NO_ENV_HINTS=1
