# name: 'oasis-aa'
# Repo-owned. [dark] and [unknown] are Oasis Abyss Dark, [light] is Oasis
# Abyss Light 3 (https://github.com/uhs-robert/oasis.nvim). Each line is
# catppuccin-aa.theme with its colour replaced by the Oasis value for the
# same Catppuccin role (role map in
# config/theme/palettes.d/oasis/light/starship.toml). Comments and
# autosuggestions use the muted overlay greys (3:1).

[light]
# preferred_background: d8d8d8
fish_color_normal 181811
fish_color_command 11508d
fish_color_param ba141a
fish_color_keyword 691fbe
fish_color_quote 31572e
fish_color_redirection 2e6b28
fish_color_end 744211
fish_color_comment 7c7a74
fish_color_error 9e1010
fish_color_gray 615f57
fish_color_selection --background=cdcdcd
fish_color_search_match --background=cdcdcd
fish_color_option 31572e
fish_color_operator 2e6b28
fish_color_escape 870f13
fish_color_autosuggestion 647276
fish_color_cancel 9e1010
fish_color_cwd 554f1c
fish_color_user 2f564a
fish_color_host 11508d
fish_color_host_remote 31572e
fish_color_status 9e1010
fish_pager_color_progress 615f57
fish_pager_color_prefix 2e6b28
fish_pager_color_completion 181811
fish_pager_color_description 647276

