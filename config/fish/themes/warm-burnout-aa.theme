# name: 'warm-burnout-aa'
# Repo-owned. [dark] and [unknown] are Warm Burnout Dark, [light] is Warm
# Burnout Light (https://github.com/felipefdl/warm-burnout). Each line is
# catppuccin-aa.theme with its colour replaced by the Warm Burnout value for
# the same Catppuccin role (role map in
# config/theme/palettes.d/warm-burnout/light/starship.toml). Comments and
# autosuggestions use the muted overlay greys (3:1).

[light]
# preferred_background: f5ede0
fish_color_normal 3a3630
fish_color_command 2868a0
fish_color_param 8e4632
fish_color_keyword 7e4060
fish_color_quote 4d5c1a
fish_color_redirection 924800
fish_color_end 8f4418
fish_color_comment 8a8070
fish_color_error b03434
fish_color_gray 938871
fish_color_selection --background=ece4d6
fish_color_search_match --background=ece4d6
fish_color_option 4d5c1a
fish_color_operator 924800
fish_color_escape 883850
fish_color_autosuggestion 6a6258
fish_color_cancel b03434
fish_color_cwd 855700
fish_color_user 286a48
fish_color_host 2868a0
fish_color_host_remote 4d5c1a
fish_color_status b03434
fish_pager_color_progress 938871
fish_pager_color_prefix 924800
fish_pager_color_completion 3a3630
fish_pager_color_description 6a6258

