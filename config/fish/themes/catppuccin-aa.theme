# name: 'catppuccin-aa'
# Repo-owned, not installed by fisher. [dark] and [unknown] are Catppuccin
# Mocha as shipped by https://github.com/catppuccin/fish. [light] is
# Catppuccin Latte with accents darkened (same HSL hue and saturation) to
# reach WCAG AA 4.5:1 on eff1f5; mapping in
# config/theme/palettes.d/starship.light.toml. Autosuggestion and pager
# description use overlay2 (3.49:1) instead of overlay0 (2.30:1) so they
# stay muted but readable. Kept out of Catppuccin Mocha.theme because
# `fisher update` rewrites that file from upstream.

[light]
# preferred_background: eff1f5
fish_color_normal 4c4f69
fish_color_command 1761f5
fish_color_param cb3333
fish_color_keyword 8839ef
fish_color_quote 327c21
fish_color_redirection c71f9a
fish_color_end be4601
fish_color_comment 8c8fa1
fish_color_error d20f39
fish_color_gray 9ca0b0
fish_color_selection --background=ccd0da
fish_color_search_match --background=ccd0da
fish_color_option 327c21
fish_color_operator c71f9a
fish_color_escape d61d2d
fish_color_autosuggestion 7c7f93
fish_color_cancel d20f39
fish_color_cwd 996114
fish_color_user 13797e
fish_color_host 1761f5
fish_color_host_remote 327c21
fish_color_status d20f39
fish_pager_color_progress 9ca0b0
fish_pager_color_prefix c71f9a
fish_pager_color_completion 4c4f69
fish_pager_color_description 7c7f93

[dark]
