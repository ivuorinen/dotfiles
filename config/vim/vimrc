  nnoremap <silent> <leader>ss :BLines<CR>

  " ── Git hunks (vim-gitgutter, as mini.diff's defaults) ──────────────
  " mini.diff's gh/gH are operators over a range; gitgutter acts on the
  " hunk under the cursor.
  nmap ]h <Plug>(GitGutterNextHunk)
  nmap [h <Plug>(GitGutterPrevHunk)
  nmap gh <Plug>(GitGutterStageHunk)
  nmap gH <Plug>(GitGutterUndoHunk)

endif

