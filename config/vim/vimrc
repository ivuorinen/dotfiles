"*****************************************************************************
"" Neovim parity (config/nvim/lua/keymaps.lua is the source of truth)
"*****************************************************************************
" Same keys, same order as keymaps.lua; nvim's plugin-backed actions map to
" the vim plugin that does the same job: snacks.picker -> fzf.vim, LSP ->
" coc.nvim, trouble -> quickfix/location lists, mini.files -> NERDTree,
" mini.bufremove -> s:BufRemove. nvim keys with no vim counterpart are left
" unmapped: <leader>ct (treesitter), <leader>xc and <leader>xt (trouble
" cascade/test) and <leader>tn (snacks notifier).
" Guarded to vim only: IdeaVim sources this file and keeps its own
" IDE-action scheme in config/ideavim/ideavimrc.
if !has('ideavim')
  " ── Splits ──────────────────────────────────────────────────────────
  nnoremap <silent> <C-w>, :vertical resize -10<CR>
  nnoremap <silent> <C-w>. :vertical resize +10<CR>
  nnoremap <silent> <C-w>- :resize -10<CR>
  nnoremap <silent> <C-w>+ :resize +10<CR>

  " ── Deal with word wrap ─────────────────────────────────────────────
  nnoremap <expr> k v:count == 0 ? 'gk' : 'k'
  nnoremap <expr> j v:count == 0 ? 'gj' : 'j'

  " ── Text manipulation ───────────────────────────────────────────────
  " nvim also binds these in normal mode, where '< and '> are the marks
  " of the previous visual selection; vim keeps them to visual mode.
  xnoremap < <gv
  xnoremap > >gv
  xnoremap <silent> <C-k> :m '<-2<CR>gv=gv
  xnoremap <silent> <C-j> :m '>+1<CR>gv=gv

  " ── Other operations ────────────────────────────────────────────────
  nnoremap <silent> <C-s> :w!<CR>
  nnoremap <silent> <Esc><Esc> :nohlsearch<CR>

  " Disable arrow keys in normal mode; use hjkl or count motions instead.
  for s:key in ['<Up>', '<Down>', '<Left>', '<Right>',
        \ '<C-Up>', '<C-Down>', '<C-Left>', '<C-Right>']
    execute 'nnoremap' s:key '<Nop>'
  endfor

  " ── Buffer operations ───────────────────────────────────────────────
  " MiniBufremove keeps the window: show another buffer in it first, then
  " delete the old one. A modified buffer is refused rather than dropped.
  function! s:BufRemove(cmd) abort
    let l:buf = bufnr('%')
    if getbufvar(l:buf, '&modified')
      echohl ErrorMsg | echo 'Buffer has unsaved changes' | echohl None
      return
    endif
    if len(getbufinfo({'buflisted': 1})) > 1
      bprevious
    else
      enew
    endif
    execute a:cmd l:buf
  endfunction

  " Close every listed buffer except the current one; skip modified ones.
  function! s:BufOnly() abort
    let l:cur = bufnr('%')
    for l:info in getbufinfo({'buflisted': 1})
      if l:info.bufnr != l:cur && !l:info.changed
        execute 'bdelete' l:info.bufnr
      endif
    endfor
  endfunction

  nnoremap <silent> <leader>ba :call <SID>BufOnly()<CR>
  nnoremap <silent> <leader>bd :call <SID>BufRemove('bdelete')<CR>
  nnoremap <silent> <leader>bh :bprevious<CR>
  nnoremap <silent> <leader>bj :bfirst<CR>
  nnoremap <silent> <leader>bk :blast<CR>
  nnoremap <silent> <leader>bl :bnext<CR>
  nnoremap <silent> <leader>bn :enew<CR>
  nnoremap <silent> <leader>bw :call <SID>BufRemove('bwipeout')<CR>

