  " Snacks terminal toggle: hide the terminal window if shown, else show
  " the existing terminal buffer, else start one.
  function! s:ToggleTerminal() abort
    for l:win in range(1, winnr('$'))
      if getbufvar(winbufnr(l:win), '&buftype') ==# 'terminal'
        execute l:win . 'hide'
        return
      endif
    endfor
    for l:info in getbufinfo()
      if getbufvar(l:info.bufnr, '&buftype') ==# 'terminal'
            \ && term_getstatus(l:info.bufnr) =~# 'running'
        execute 'botright sbuffer' l:info.bufnr
        resize 15
        return
      endif
    endfor
    botright terminal ++rows=15
  endfunction
  nnoremap <silent> <leader>tt :call <SID>ToggleTerminal()<CR>

