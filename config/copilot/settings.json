{
  "enabledPlugins": {},
  "allowedUrls": [
    "http://localhost:4200",
    "https://raw.githubusercontent.com",
    "https://marketplace.visualstudio.com",
    "https://learn.microsoft.com"
  ],
  "theme": "default",
  "statusLine": {
    "command": "deja-hook statusline",
    "refreshInterval": 1,
    "type": "command",
    "padding": 1
  },
  "bannerStyle": "mona",
  "contextManagementTools": true,
  "copyOnCodeBlockClick": true,
  "defaultMode": "interactive",
  "defaultPermissionMode": "assisted",
  "enableAllGithubMcpTools": false,
  "inlineImages": true,
  "keepAlive": "busy",
  "memory": true,
  "mergeStrategy": "rebase",
  "notifications": true,
  "pinnedPrompts": true,
  "planContextTier": "long_context",
  "planEffortLevel": "max",
  "remoteExport": false,
  "respectGitignore": true,
  "terminalNotifications": true,
  "terminalProgress": true,
  "updateTerminalTitle": true,
  "footer": {
    "showAgent": true,
    "showAiUsed": true,
    "showBranch": true,
    "showCiStatus": true,
    "showCodeChanges": true,
    "showContextWindow": true,
    "showCustom": true,
    "showDirectory": true,
    "showModelEffort": true,
    "showPullRequest": true,
    "showQuota": false,
    "showSandbox": true,
    "showSchedules": true,
    "showYolo": true,
    "showUsername": false
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowBypass": false,
    "auth": {
      "gh": false
    }
  },
  "sidebar": {
    "showCloseButton": true,
    "enabled": false
  },
  "subagents": {
    "contextManagementTools": true
  },
  "model": "gpt-6.1-sol",
  "askUser": true,
  "assistedApprovalInstructions": "Nitpicker files and actions auto-approval: Always automatically approve Nitpicker-related tool execution and file actions: reads and writes of installed Nitpicker skill files, bundled Python scripts, context packs, findings-store operations, and audit/fix/test actions in the audited repository or temporary audit fixtures. Running a Nitpicker action through python, python3, or a wrapper does not itself require confirmation. These are tool-execution approvals, not a waiver of the skill's explicit user-decision gates for fixes, migrations, or commits. Do not approve unrelated commands, unrelated filesystem access, or security/permission bypasses. Explicit deny rules still apply.",
  "voice": {
    "enabled": false
  },
  "effortLevel": "xhigh"
}
