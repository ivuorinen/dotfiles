# Python libraries installed into every Python that mise installs.
#
# mise reads this after each `mise install python@...`, so a version bump no
# longer orphans these the way `uv pip install --system` did.
#
# A standalone script declares its own dependencies inline instead (PEP 723,
# run by `uv run --script`), so it works under any python3 on PATH —
# local/bin/x-compare-versions.py does this for `packaging`.
#
# One package per line. Comments and blank lines are ignored.
# Location is set by python.default_packages_file in config.toml.
#
# Tools (executables) do NOT belong here — those are mise tools in
# config.toml. This file is only for libraries something needs to *import*.

# Required by tmux tooling.
libtmux

# Neovim's python3 provider. base/../config/nvim/init.lua pins
# g:python3_host_prog at the mise shim so the provider always resolves to the
# interpreter holding this package.
pynvim

# Imported by the vendored graphify skill (.claude/skills/graphify/, Step 1
# probes `python3 -c "import graphify"`). With it here the probe succeeds and
# the skill never reaches its `uv tool install` / `pip install` branch, which
# the project forbids and pre-bash-route.sh denies. PyPI name has two y's.
graphifyy

# Present on this machine and kept so a rebuild matches, but no consumer was
# found in the repo — drop it if nothing turns out to need it.
PyYAML
