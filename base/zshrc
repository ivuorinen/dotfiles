# this is my zsh config. there are many like it, but this one is mine.
# https://zsh.sourceforge.io/Intro/intro_3.html
# shellcheck shell=bash

# export VERBOSE=1
# export DEBUG=1

# Respect an inherited DOTFILES (./install, bats fixtures) before defaulting.
export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
# Minimal PATH for x-have and utilities; full PATH set in shared.sh/exports
export PATH="$HOME/.local/bin:$DOTFILES/local/bin:$PATH"
export SHARED_SCRIPTS_SOURCED=0

source "$DOTFILES/config/shared.sh"

# zsh completions directory (ZSH_CUSTOM_COMPLETION_PATH set in shared.sh)
ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump-${SHORT_HOST}-${ZSH_VERSION}"

source "$DOTFILES/config/zsh/antidote.zsh"

# config/alias is sourced via shared.sh (above) before antidote, so the OMZ
# git plugin's aliases would otherwise shadow ours. Re-apply the alias file so
# config/alias stays authoritative (the secret-file loop is guarded to run once).
source "$DOTFILES/config/alias"

# Function to source FZF configuration
source_fzf_config()
{
  local fzf_config="${DOTFILES}/config/fzf/fzf.zsh"
  if [[ -f "$fzf_config" ]]; then
    # shellcheck source=config/fzf/fzf.zsh
    source "$fzf_config"
  fi
}

source_fzf_config
# Cached via lib::init_cached for the same reason as in base/bashrc: these
# resolve through mise shims, and a shim call costs ~80ms against ~2ms for
# the real binary. zprof does not show this — it profiles functions, not
# top-level evals.
x-have antidot && lib::init_cached antidot antidot init --shell zsh

# Add usage-generated completions to fpath
fpath=("${XDG_CONFIG_HOME:-$HOME/.config}/zsh/completions.d" $fpath)

# compinit itself is owned by the ez-compinit plugin (loaded through
# antidote above), which honours $ZSH_COMPDUMP and so uses the same dumpfile
# set at the top of this file. Calling compinit again here ran it twice on
# every start — 37ms of compinit plus 17ms of compaudit, for nothing.
# bashcompinit still has to be requested explicitly.
autoload -Uz bashcompinit
bashcompinit

# Starship prompt — colours flip via ~/.config/starship.toml symlink swap
# managed by the theme orchestrator (config/theme/handlers.d/starship).
# `enable_transience` collapses prior prompts to just the character symbol
# so scrollback stays clean (matches tide --transient=Yes).
if command -v starship > /dev/null 2>&1; then
  lib::init_cached starship starship init zsh
  function starship_transient_prompt_func() {
    starship module character
  }
  # starship's zsh init does not define enable_transience (checked against
  # 1.26.0: absent from both `starship init zsh` and --print-full-init),
  # unlike the fish init, which does. Calling it unguarded printed
  # "command not found: enable_transience" on every zsh start. The guard
  # keeps the intent for a future starship that ships it.
  (( $+functions[enable_transience] )) && enable_transience
fi

if command -v wt > /dev/null 2>&1; then
  lib::init_cached wt command wt config shell init zsh
fi
