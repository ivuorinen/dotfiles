# this is my bashrc config. there are many like it, but this one is mine.
# shellcheck shell=bash

# Respect an inherited DOTFILES (./install, bats fixtures) before defaulting.
export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
# Minimal PATH for x-have and utilities; full PATH set in shared.sh/exports
export PATH="$HOME/.local/bin:$DOTFILES/local/bin:$PATH"
export SHARED_SCRIPTS_SOURCED=0

source "$DOTFILES/config/shared.sh"

# shellcheck source=../config/fzf/fzf.bash
[ -f "${DOTFILES}/config/fzf/fzf.bash" ] &&
  source "${DOTFILES}/config/fzf/fzf.bash"

# Source usage-generated bash completions
for f in "$HOME/.config/bash/completions.d/"*.bash; do
  [[ -f "$f" ]] && source "$f"
done
unset f

# Import ssh keys in keychain (macOS-specific -A flag, silently fails on Linux)
ssh-add -A 2>/dev/null

# These three go through lib::init_cached (config/lib.sh): by this point
# PATH leads with the mise shims, and each shim call re-enters mise to
# resolve a version — `starship init bash` costs ~200ms through the shim
# against ~8ms to source its cached output.
x-have antidot && lib::init_cached antidot antidot init --shell bash

PROMPT_DIRTRIM=3

# Starship prompt — colours flip via ~/.config/starship.toml symlink swap
# managed by the theme orchestrator (config/theme/handlers.d/starship).
command -v starship > /dev/null 2>&1 && lib::init_cached starship starship init bash

if command -v wt > /dev/null 2>&1; then
  lib::init_cached wt command wt config shell init bash
fi
